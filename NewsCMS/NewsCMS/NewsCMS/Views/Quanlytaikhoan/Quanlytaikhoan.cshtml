@{
    ViewData["Title"] = "Quản lý tài khoản";
    var bang = ViewBag.bang as IEnumerable<NewsCMS.Models.TaiKhoanModel>;
}
@{
    Layout = "~/Views/Shared/_AdminLTELayout.cshtml";
}

<style>
    .slate-panel {
        background: #131b2e;
        border: 1px solid #23314d;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
        transition: all 0.25s ease;
    }

    .slate-panel-header {
        background: rgba(26, 36, 61, 0.6);
        border-bottom: 1px solid #23314d;
        padding: 18px 24px;
        border-radius: 16px 16px 0 0;
    }

    .slate-search-group .input-group-text {
        background: #1a243d;
        border: 1px solid #2a3a5c;
        border-right: none;
        color: #38bdf8;
        border-radius: 10px 0 0 10px;
    }

    .slate-search-group .form-control {
        background: #1a243d;
        border: 1px solid #2a3a5c;
        border-left: none;
        color: #f1f5f9;
        border-radius: 0 10px 10px 0;
        padding: 10px 14px;
    }

        .slate-search-group .form-control:focus {
            box-shadow: none;
            border-color: #38bdf8;
        }

        .slate-search-group .form-control::placeholder {
            color: #64748b;
        }

    .btn-slate-search {
        background: linear-gradient(135deg, #0284c7, #2563eb);
        border: none;
        color: #ffffff;
        font-weight: 600;
        border-radius: 10px;
        padding: 10px 16px;
        transition: all 0.2s ease;
    }

        .btn-slate-search:hover {
            opacity: 0.9;
            color: #ffffff;
            transform: translateY(-1px);
        }

    .btn-slate-home {
        background: #1a243d;
        border: 1px solid #2a3a5c;
        color: #38bdf8;
        font-weight: 600;
        transition: all 0.2s ease;
    }

        .btn-slate-home:hover {
            background: rgba(56, 189, 248, 0.15);
            border-color: #38bdf8;
            color: #ffffff;
            transform: translateY(-1px);
        }

    .slate-table {
        color: #e2e8f0;
        margin-bottom: 0;
    }

        .slate-table thead th {
            background: #1a243d;
            color: #94a3b8;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            border-bottom: 1px solid #23314d;
            padding: 15px 16px;
            white-space: nowrap;
        }

        .slate-table tbody td {
            background: transparent;
            border-bottom: 1px solid #1e293b;
            padding: 14px 16px;
            color: #e2e8f0;
            font-size: 14px;
        }

        .slate-table tbody tr {
            transition: background-color 0.2s ease;
        }

            .slate-table tbody tr:hover td {
                background-color: rgba(56, 189, 248, 0.06);
            }

            .slate-table tbody tr:last-child td {
                border-bottom: none;
            }

    .badge-status-active {
        background: rgba(16, 185, 129, 0.15);
        color: #34d399;
        border: 1px solid rgba(16, 185, 129, 0.3);
        font-weight: 600;
    }

    .badge-status-locked {
        background: rgba(239, 68, 68, 0.15);
        color: #f87171;
        border: 1px solid rgba(239, 68, 68, 0.3);
        font-weight: 600;
    }

    .btn-action-edit {
        background: rgba(245, 158, 11, 0.15);
        color: #fbbf24;
        border: 1px solid rgba(245, 158, 11, 0.3);
        font-weight: 600;
        transition: all 0.2s ease;
    }

        .btn-action-edit:hover {
            background: #f59e0b;
            color: #0f172a;
            transform: translateY(-2px);
        }

    .btn-action-delete {
        background: rgba(239, 68, 68, 0.15);
        color: #f87171;
        border: 1px solid rgba(239, 68, 68, 0.3);
        font-weight: 600;
        transition: all 0.2s ease;
    }

        .btn-action-delete:hover {
            background: #ef4444;
            color: #ffffff;
            transform: translateY(-2px);
        }
</style>

<div class="container-fluid py-3 px-3">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1" style="color: #f8fafc;">
                <i class="bi bi-people-fill me-2" style="color: #38bdf8;"></i>Quản lý tài khoản
            </h2>
            <p class="mb-0" style="color: #94a3b8; font-size: 14px;">Quản lý thông tin và trạng thái các tài khoản trong hệ thống</p>
        </div>

        <a asp-controller="Trangchu" asp-action="Trangdau"
           class="btn btn-slate-home rounded-pill px-4 py-2">
            <i class="bi bi-house-door-fill me-1"></i> Quay về trang chủ
        </a>
    </div>

    <div class="slate-panel mb-4">
        <div class="p-3">
            <form asp-controller="Quanlytaikhoan" asp-action="Quanlytaikhoan" method="get">
                <div class="row g-2 align-items-center">
                    <div class="col-md-10">
                        <div class="input-group slate-search-group">
                            <span class="input-group-text">
                                <i class="bi bi-search"></i>
                            </span>

                            <input type="text"
                                   name="timkiem"
                                   value="@Context.Request.Query["timkiem"]"
                                   class="form-control"
                                   placeholder="Nhập tên đăng nhập hoặc Email cần tìm..." />
                        </div>
                    </div>

                    <div class="col-md-2">
                        <button type="submit" class="btn btn-slate-search w-100">
                            <i class="bi bi-search me-1"></i> Tìm kiếm
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="slate-panel overflow-hidden">
        <div class="slate-panel-header d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0" style="color: #f8fafc; font-size: 16px;">
                <i class="bi bi-table me-2" style="color: #38bdf8;"></i>Danh sách tài khoản
            </h5>

            <span class="badge rounded-pill px-3 py-2" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3);">
                @(bang == null ? 0 : bang.Count()) tài khoản
            </span>
        </div>

        <div class="p-0">
            <div class="table-responsive">
                <table class="table slate-table align-middle text-center">
                    <thead>
                        <tr>
                            <th>Mã tài khoản</th>
                            <th>Tên đăng nhập</th>
                            <th>Email</th>
                            <th>Vai trò</th>
                            <th>Ngày tạo</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (bang != null && bang.Any())
                        {
                            @foreach (var item in bang)
                            {
                                <tr>
                                    <td class="fw-bold" style="color: #38bdf8;">
                                        #@item.MaTaiKhoan
                                    </td>

                                    <td class="fw-semibold" style="color: #f8fafc;">
                                        @item.TenDangNhap
                                    </td>

                                    <td style="color: #cbd5e1;">
                                        @item.Email
                                    </td>

                                    <td>
                                        <span class="badge rounded-pill px-3 py-1" style="background: #1e293b; color: #94a3b8; border: 1px solid #334155;">
                                            @item.MaVaiTro
                                        </span>
                                    </td>

                                    <td style="color: #94a3b8;">
                                        @item.NgayTao.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @if (item.TrangThai == true)
                                        {
                                            <span class="badge badge-status-active rounded-pill px-3 py-2">
                                                Hoạt động
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-status-locked rounded-pill px-3 py-2">
                                                Đã khóa
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex justify-content-center gap-2">
                                            <a asp-controller="Quanlytaikhoan"
                                               asp-action="Suataikhoan"
                                               asp-route-id="@item.MaTaiKhoan"
                                               class="btn btn-sm btn-action-edit rounded-pill px-3">
                                                <i class="bi bi-pencil-square me-1"></i> Sửa
                                            </a>

                                            <a asp-controller="Quanlytaikhoan"
                                               asp-action="Xoa"
                                               asp-route-id="@item.MaTaiKhoan"
                                               class="btn btn-sm btn-action-delete rounded-pill px-3">
                                                <i class="bi bi-trash me-1"></i> Xóa
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="py-5" style="color: #64748b;">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    Không tìm thấy tài khoản nào.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>