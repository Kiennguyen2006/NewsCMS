@{
    ViewData["Title"] = "Quản lý tài khoản";
    var bang = ViewBag.bang as IEnumerable<NewsCMS.Models.TaiKhoanModel>;
}
@{
    Layout = "~/Views/Shared/_AdminLTELayout.cshtml";
}
<div class="container-fluid py-4 px-4">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">
                <i class="bi bi-people-fill"></i> Quản lý tài khoản
            </h2>
            <p class="text-muted mb-0">Quản lý thông tin và trạng thái các tài khoản trong hệ thống</p>
        </div>

        <a asp-controller="Trangchu" asp-action="Trangdau"
           class="btn btn-outline-primary rounded-pill px-4">
            <i class="bi bi-house-door-fill"></i> Quay về trang chủ
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form asp-controller="Quanlytaikhoan" asp-action="Quanlytaikhoan" method="get">
                <div class="row g-2 align-items-center">
                    <div class="col-md-10">
                        <div class="input-group">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-search"></i>
                            </span>

                            <input type="text"
                                   name="timkiem"
                                   value="@Context.Request.Query["timkiem"]"
                                   class="form-control"
                                   placeholder="Nhập tên đăng nhập hoặc Email cần tìm..." />
                        </div>
                    </div>

                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-search"></i> Tìm kiếm
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-table text-primary"></i> Danh sách tài khoản
            </h5>

            <span class="badge bg-primary rounded-pill px-3 py-2">
                @(bang == null ? 0 : bang.Count()) tài khoản
            </span>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle text-center mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="py-3">Mã tài khoản</th>
                            <th>Tên đăng nhập</th>
                            <th>Email</th>
                            <th>Vai trò</th>
                            <th>Ngày tạo</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (bang != null && bang.Any())
                        {
                            @foreach (var item in bang)
                            {
                                <tr>
                                    <td class="fw-bold text-primary">
                                        @item.MaTaiKhoan
                                    </td>

                                    <td class="fw-semibold">
                                        @item.TenDangNhap
                                    </td>

                                    <td>
                                        @item.Email
                                    </td>

                                    <td>
                                        @item.MaVaiTro
                                    </td>

                                    <td>
                                        @item.NgayTao.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @if (item.TrangThai == true)
                                        {
                                            <span class="badge bg-success rounded-pill px-3 py-2">
                                                Hoạt động
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger rounded-pill px-3 py-2">
                                                Đã khóa
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex justify-content-center gap-2">
                                            <a asp-controller="Quanlytaikhoan"
                                               asp-action="Suataikhoan"
                                               asp-route-id="@item.MaTaiKhoan"
                                               class="btn btn-sm btn-warning rounded-pill px-3">
                                                <i class="bi bi-pencil-square"></i> Sửa
                                            </a>

                                            <a asp-controller="Quanlytaikhoan"
                                               asp-action="Xoa"
                                               asp-route-id="@item.MaTaiKhoan"
                                               class="btn btn-sm btn-danger rounded-pill px-3">
                                                <i class="bi bi-trash"></i> Xóa
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    Không tìm thấy tài khoản nào.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<style>
    .card {
        transition: all 0.25s ease;
    }

    .table tbody tr {
        transition: background-color 0.2s ease;
    }

        .table tbody tr:hover {
            background-color: #f0f6ff;
        }

    .btn {
        transition: all 0.2s ease;
    }

        .btn:hover {
            transform: translateY(-2px);
        }

    .table th {
        white-space: nowrap;
    }
</style>
