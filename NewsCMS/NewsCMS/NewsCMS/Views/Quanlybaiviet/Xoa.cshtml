@{
    Layout = "~/Views/Shared/_AdminLTELayout.cshtml";
}
@using NewsCMS.Models

@{
    ViewData["Title"] = "Xác nhận xóa bài viết";
    var baiViet = ViewBag.dongcu as BaiVietModel;
    bool daDuyet = baiViet != null && baiViet.MaNhanVienDuyet != null;
}

@if (baiViet != null)
{
    <div class="delete-container">
        <div class="delete-card">

            <div class="delete-heading">
                <div class="delete-icon"><i class="bi bi-exclamation-lg"></i></div>
                <h2>Xác nhận xóa bài viết</h2>
                <p>Bạn có chắc chắn muốn xóa bài viết này không?</p>
            </div>

            @if (!daDuyet)
            {
                <div class="delete-error">
                    <strong><i class="bi bi-x-circle-fill me-1"></i> Không thể xóa bài viết!</strong>
                    <p>
                        Bài viết chưa được Chủ biên duyệt.
                        Bạn phải hoàn thành quy trình duyệt trước khi thực hiện xóa.
                    </p>
                </div>
            }
            else
            {
                <div class="delete-success">
                    <i class="bi bi-check-circle-fill me-1"></i>
                    Bài viết đã được Chủ biên duyệt. Bạn có thể thực hiện xóa.
                </div>
            }

            <div class="delete-content">

                <div class="delete-row">
                    <span>Mã bài viết</span>
                    <strong style="color: #38bdf8;">#@baiViet.MaBaiViet</strong>
                </div>

                <div class="delete-row">
                    <span>Tiêu đề</span>
                    <strong>@baiViet.TieuDe</strong>
                </div>

                <div class="delete-row">
                    <span>Tóm tắt</span>
                    <p>@baiViet.TomTat</p>
                </div>

                <div class="delete-row">
                    <span>Ảnh đại diện</span>

                    @if (!string.IsNullOrWhiteSpace(baiViet.AnhDaiDien))
                    {
                        <img src="@Url.Content("~/images/" + baiViet.AnhDaiDien)"
                             alt="@baiViet.TieuDe"
                             class="delete-image" />
                    }
                    else
                    {
                        <p>Không có ảnh đại diện</p>
                    }
                </div>

                <div class="delete-row">
                    <span>Nội dung bài viết</span>
                    <div class="article-content">
                        @Html.Raw(baiViet.NoiDung)
                    </div>
                </div>

                <div class="delete-row">
                    <span>Trạng thái bài viết</span>
                    <strong>@baiViet.TrangThai</strong>
                </div>

                <div class="delete-row">
                    <span>Mã nhân viên duyệt</span>
                    @if (daDuyet)
                    {
                        <strong>@baiViet.MaNhanVienDuyet</strong>
                    }
                    else
                    {
                        <strong style="color: #f87171;">Chưa được duyệt</strong>
                    }
                </div>

            </div>

            <div class="delete-warning">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                Lưu ý: Khi xóa bài viết, các lịch sử duyệt và bình luận
                liên quan cũng sẽ bị xóa. Bạn không thể hoàn tác thao tác này.
            </div>

            <div class="delete-actions">

                @if (daDuyet)
                {
                    <form asp-controller="Quanlybaiviet"
                          asp-action="Xoabv"
                          asp-route-id="@baiViet.MaBaiViet"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit" class="btn-delete">
                            <i class="bi bi-trash3 me-1"></i> Xóa bài viết
                        </button>
                    </form>
                }
                else
                {
                    <button type="button" class="btn-delete" disabled>
                        <i class="bi bi-lock me-1"></i> Chưa thể xóa bài viết
                    </button>
                }

                <a asp-controller="Quanlybaiviet"
                   asp-action="Quanlybaiviet"
                   class="btn-back">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại
                </a>

            </div>

        </div>
    </div>
}

<style>
    .delete-container {
        max-width: 900px;
        margin: 25px auto;
        padding: 15px;
    }

    .delete-card {
        background: #131b2e;
        border: 1px solid #23314d;
        border-radius: 16px;
        padding: 32px;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.35);
    }

    .delete-heading {
        text-align: center;
        padding-bottom: 22px;
        border-bottom: 1px solid #23314d;
    }

    .delete-icon {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 14px;
        border-radius: 50%;
        background: rgba(239, 68, 68, 0.15);
        border: 1px solid rgba(239, 68, 68, 0.35);
        color: #f87171;
        font-size: 26px;
        font-weight: bold;
    }

    .delete-heading h2 {
        color: #f8fafc;
        margin: 0 0 8px;
        font-size: 23px;
        font-weight: 800;
    }

    .delete-heading p {
        color: #94a3b8;
        margin: 0;
        font-size: 14px;
    }

    .delete-error {
        margin-top: 20px;
        padding: 16px;
        background: rgba(239, 68, 68, 0.12);
        border: 1px solid rgba(239, 68, 68, 0.3);
        border-radius: 12px;
        color: #f87171;
    }

        .delete-error p {
            margin: 6px 0 0;
            line-height: 1.6;
            color: #fca5a5;
            font-size: 14px;
        }

    .delete-success {
        margin-top: 20px;
        padding: 14px 16px;
        background: rgba(16, 185, 129, 0.12);
        border: 1px solid rgba(16, 185, 129, 0.3);
        border-radius: 12px;
        color: #34d399;
        font-weight: 600;
        font-size: 14px;
    }

    .delete-content {
        margin-top: 20px;
    }

    .delete-row {
        padding: 16px 0;
        border-bottom: 1px solid #23314d;
    }

        .delete-row > span {
            display: block;
            margin-bottom: 8px;
            color: #94a3b8;
            font-size: 13px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .delete-row strong {
            color: #f1f5f9;
            font-size: 15px;
            overflow-wrap: anywhere;
        }

        .delete-row p {
            color: #cbd5e1;
            margin: 0;
            line-height: 1.7;
            font-size: 14px;
        }

    .delete-image {
        display: block;
        max-width: 260px;
        max-height: 185px;
        object-fit: cover;
        border-radius: 10px;
        border: 1px solid #2a3a5c;
    }

    .article-content {
        padding: 18px;
        background: #1a243d;
        border: 1px solid #2a3a5c;
        border-radius: 12px;
        color: #e2e8f0;
        line-height: 1.8;
        overflow-wrap: anywhere;
        max-width: 100%;
    }

        .article-content img {
            max-width: 100%;
            height: auto;
            border-radius: 8px;
        }

        .article-content iframe,
        .article-content video {
            max-width: 100%;
        }

        .article-content table {
            max-width: 100%;
            border-collapse: collapse;
        }

        .article-content pre {
            white-space: pre-wrap;
            overflow-wrap: anywhere;
        }

    .delete-warning {
        margin-top: 22px;
        padding: 14px 16px;
        background: rgba(245, 158, 11, 0.12);
        border: 1px solid rgba(245, 158, 11, 0.3);
        border-radius: 12px;
        color: #fbbf24;
        font-size: 14px;
        line-height: 1.6;
    }

    .delete-actions {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 14px;
        margin-top: 28px;
    }

        .delete-actions form {
            margin: 0;
        }

    .btn-delete,
    .btn-back {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        min-width: 160px;
        padding: 11px 22px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-delete {
        background: linear-gradient(135deg, #dc2626, #b91c1c);
        border: 1px solid rgba(248, 113, 113, 0.4);
        color: #fff;
        box-shadow: 0 4px 15px rgba(220, 38, 38, 0.3);
    }

        .btn-delete:hover:not(:disabled) {
            background: linear-gradient(135deg, #ef4444, #dc2626);
            transform: translateY(-1px);
        }

        .btn-delete:disabled {
            background: #1e293b;
            border: 1px solid #334155;
            color: #64748b;
            box-shadow: none;
            cursor: not-allowed;
        }

    .btn-back {
        background: #1e293b;
        border: 1px solid #334155;
        color: #cbd5e1;
    }

        .btn-back:hover {
            background: #334155;
            color: #ffffff;
        }

    @@media (max-width: 600px) {
        .delete-card {
            padding: 20px;
        }

        .delete-actions {
            flex-direction: column;
        }

            .delete-actions form,
            .btn-delete,
            .btn-back {
                width: 100%;
            }
    }
</style>