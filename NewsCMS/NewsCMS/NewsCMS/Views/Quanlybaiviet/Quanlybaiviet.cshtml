@{
    Layout = "~/Views/Shared/_AdminLTELayout.cshtml";
}
@{
    ViewData["Title"] = "Quản lý bài viết";

    var bang = ViewBag.bang;

    int maVaiTro = Context.Session.GetInt32("MaVaiTro") ?? 0;

    bool laBienTapVien = maVaiTro == 2;
    bool laChuBien = maVaiTro == 3;
    bool laQuanTriVien = maVaiTro == 1;
    int soCot = (laBienTapVien || laChuBien) ? 7 : 6;
}

<style>
    .ql-container {
        min-height: 100vh;
        padding: 15px;
        color: #e2e8f0;
        box-sizing: border-box;
    }

        .ql-container * {
            box-sizing: border-box;
        }

    .ql-content {
        max-width: 1500px;
        margin: 0 auto;
    }

    .ql-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 18px;
        margin-bottom: 24px;
    }

        .ql-header h2 {
            margin: 0;
            color: #f8fafc;
            font-size: 26px;
            font-weight: 800;
        }

            .ql-header h2 i {
                margin-right: 8px;
                color: #38bdf8;
            }

        .ql-header p {
            margin: 6px 0 0;
            color: #94a3b8;
            font-size: 14px;
        }

    .ql-header-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    .ql-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 10px 18px;
        border-radius: 10px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
        transition: all .2s ease;
    }

    .ql-btn-home {
        color: #38bdf8;
        background: #1a243d;
        border: 1px solid #2a3a5c;
    }

        .ql-btn-home:hover {
            color: #fff;
            background: rgba(56, 189, 248, 0.15);
            border-color: #38bdf8;
            transform: translateY(-2px);
        }

    .ql-btn-add {
        color: #fff;
        background: linear-gradient(135deg, #0284c7, #2563eb);
        border: 1px solid rgba(56, 189, 248, 0.4);
        box-shadow: 0 4px 15px rgba(2, 132, 199, 0.25);
    }

        .ql-btn-add:hover {
            color: #fff;
            opacity: 0.92;
            transform: translateY(-2px);
        }

    .ql-btn-search {
        color: #fff;
        background: linear-gradient(135deg, #0284c7, #2563eb);
        border: none;
    }

        .ql-btn-search:hover {
            color: #fff;
            opacity: 0.92;
        }

    .ql-btn-reset {
        color: #cbd5e1;
        background: #1e293b;
        border: 1px solid #334155;
    }

        .ql-btn-reset:hover {
            color: #fff;
            background: #334155;
        }

    .ql-search-box {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 18px;
        margin-bottom: 24px;
        background: #131b2e;
        border: 1px solid #23314d;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    }

    .ql-search-input {
        position: relative;
        flex: 1;
    }

        .ql-search-input i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #38bdf8;
        }

        .ql-search-input input {
            width: 100%;
            height: 43px;
            padding: 0 14px 0 42px;
            background: #1a243d;
            border: 1px solid #2a3a5c;
            border-radius: 10px;
            outline: none;
            color: #f1f5f9;
            font-size: 14px;
            transition: .2s;
        }

            .ql-search-input input::placeholder {
                color: #64748b;
            }

            .ql-search-input input:focus {
                border-color: #38bdf8;
                box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15);
            }

    .ql-table-container {
        overflow: hidden;
        background: #131b2e;
        border: 1px solid #23314d;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    }

    .ql-table-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        padding: 20px 24px;
        background: rgba(26, 36, 61, 0.6);
        border-bottom: 1px solid #23314d;
    }

        .ql-table-heading h4 {
            margin: 0;
            color: #f8fafc;
            font-size: 16px;
            font-weight: 700;
        }

            .ql-table-heading h4 i {
                margin-right: 8px;
                color: #38bdf8;
            }

    .ql-role {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 6px 14px;
        color: #38bdf8;
        background: rgba(56, 189, 248, 0.15);
        border: 1px solid rgba(56, 189, 248, 0.3);
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .ql-table-scroll {
        width: 100%;
        overflow-x: auto;
    }

    .ql-table {
        width: 100%;
        min-width: 1050px;
        border-collapse: collapse;
    }

        .ql-table thead th {
            padding: 15px 16px;
            color: #94a3b8;
            background: #1a243d;
            border-bottom: 1px solid #23314d;
            text-align: left;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            white-space: nowrap;
        }

        .ql-table tbody td {
            padding: 15px 16px;
            color: #cbd5e1;
            border-bottom: 1px solid #1e293b;
            font-size: 14px;
            vertical-align: middle;
        }

        .ql-table tbody tr {
            transition: background .2s ease;
        }

            .ql-table tbody tr:hover {
                background: rgba(56, 189, 248, 0.06);
            }

            .ql-table tbody tr:last-child td {
                border-bottom: none;
            }

    .ql-id {
        color: #38bdf8 !important;
        font-weight: 700;
        white-space: nowrap;
    }

    .ql-title {
        max-width: 320px;
        color: #f8fafc !important;
        font-weight: 600;
        line-height: 1.5;
    }

    .ql-author {
        color: #cbd5e1;
        font-weight: 600;
        white-space: nowrap;
    }

    .ql-category {
        display: inline-block;
        padding: 5px 11px;
        color: #94a3b8;
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .ql-date {
        color: #94a3b8;
        white-space: nowrap;
    }

    .ql-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

        .ql-status i {
            font-size: 7px;
        }

    .status-hoanthanh {
        color: #34d399;
        background: rgba(16, 185, 129, 0.15);
        border: 1px solid rgba(16, 185, 129, 0.3);
    }

    .status-choduyet {
        color: #fbbf24;
        background: rgba(245, 158, 11, 0.15);
        border: 1px solid rgba(245, 158, 11, 0.3);
    }

    .status-cansua {
        color: #f87171;
        background: rgba(239, 68, 68, 0.15);
        border: 1px solid rgba(239, 68, 68, 0.3);
    }

    .status-default {
        color: #94a3b8;
        background: #1e293b;
        border: 1px solid #334155;
    }

    .ql-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
    }

    .ql-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        min-width: 72px;
        padding: 7px 12px;
        border-radius: 20px;
        text-decoration: none;
        font-size: 12px;
        font-weight: 600;
        transition: .2s ease;
    }

    .ql-action-edit {
        color: #fbbf24;
        background: rgba(245, 158, 11, 0.15);
        border: 1px solid rgba(245, 158, 11, 0.3);
    }

        .ql-action-edit:hover {
            color: #0f172a;
            background: #f59e0b;
            transform: translateY(-2px);
        }

    .ql-action-delete {
        color: #f87171;
        background: rgba(239, 68, 68, 0.15);
        border: 1px solid rgba(239, 68, 68, 0.3);
    }

        .ql-action-delete:hover {
            color: #fff;
            background: #ef4444;
            transform: translateY(-2px);
        }

    .ql-empty {
        padding: 55px 20px !important;
        text-align: center;
        color: #64748b !important;
    }

        .ql-empty i {
            display: block;
            margin-bottom: 12px;
            color: #475569;
            font-size: 35px;
        }

        .ql-empty strong {
            display: block;
            margin-bottom: 6px;
            color: #cbd5e1;
            font-size: 15px;
        }

    .ql-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        padding: 16px 24px;
        color: #64748b;
        background: rgba(26, 36, 61, 0.4);
        border-top: 1px solid #23314d;
        font-size: 13px;
    }

        .ql-footer strong {
            color: #38bdf8;
        }

    @@media (max-width: 768px) {
        .ql-container {
            padding: 12px;
        }

        .ql-header {
            align-items: flex-start;
            flex-direction: column;
        }

            .ql-header h2 {
                font-size: 22px;
            }

        .ql-search-box {
            flex-wrap: wrap;
        }

        .ql-search-input {
            flex-basis: 100%;
        }

        .ql-search-box .ql-btn {
            flex: 1;
        }

        .ql-table-heading {
            padding: 16px;
        }
    }

    @@media (max-width: 420px) {
        .ql-header-actions {
            width: 100%;
        }

            .ql-header-actions .ql-btn {
                flex: 1;
            }
    }
</style>

<div class="ql-container">
    <div class="ql-content">

        <div class="ql-header">
            <div>
                <h2>
                    <i class="bi bi-newspaper"></i>
                    Quản lý bài viết
                </h2>

                <p>
                    Theo dõi, tìm kiếm và quản lý các bài viết trong hệ thống NewsCMS.
                </p>
            </div>

            <div class="ql-header-actions">
                <a asp-controller="Trangchu"
                   asp-action="Trangdau"
                   class="ql-btn ql-btn-home">
                    <i class="bi bi-house-door-fill"></i>
                    Quay về trang chủ
                </a>

                @if (laBienTapVien)
                {
                    <a asp-controller="Quanlybaiviet"
                       asp-action="Them"
                       class="ql-btn ql-btn-add">
                        <i class="bi bi-plus-lg"></i>
                        Thêm bài viết
                    </a>
                }
            </div>
        </div>

        <form asp-controller="Quanlybaiviet"
              asp-action="Quanlybaiviet"
              method="get"
              class="ql-search-box">

            <div class="ql-search-input">
                <i class="bi bi-search"></i>

                <input type="text"
                       name="timkiem"
                       value="@Context.Request.Query["timkiem"]"
                       placeholder="Nhập tiêu đề bài viết cần tìm..." />
            </div>

            <button type="submit" class="ql-btn ql-btn-search">
                <i class="bi bi-search"></i>
                Tìm kiếm
            </button>

            <a asp-controller="Quanlybaiviet"
               asp-action="Quanlybaiviet"
               class="ql-btn ql-btn-reset">
                <i class="bi bi-arrow-counterclockwise"></i>
                Làm mới
            </a>
        </form>

        <div class="ql-table-container">

            <div class="ql-table-heading">
                <h4>
                    <i class="bi bi-list-ul"></i>
                    Danh sách bài viết
                </h4>

                @if (laBienTapVien)
                {
                    <span class="ql-role">
                        <i class="fa-solid fa-pen-to-square"></i>
                        Biên tập viên
                    </span>
                }
                else if (laChuBien)
                {
                    <span class="ql-role">
                        <i class="fa-solid fa-user-shield"></i>
                        Chủ biên
                    </span>
                }
                else
                {
                    <span class="ql-role">
                        <i class="fa-solid fa-eye"></i>
                        Chế độ xem
                    </span>
                }
            </div>

            <div class="ql-table-scroll">
                <table class="ql-table">
                    <thead>
                        <tr>
                            <th>Mã bài viết</th>
                            <th>Tiêu đề bài viết</th>
                            <th>Mã nhân viên</th>
                            <th>Mã danh mục</th>
                            <th>Trạng thái</th>
                            <th>Ngày tạo</th>

                            @if (laBienTapVien || laChuBien || laQuanTriVien)
                            {
                                <th>Thao tác</th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @if (bang != null && bang.Count > 0)
                        {
                            foreach (var item in bang)
                            {
                                <tr>
                                    <td class="ql-id">
                                        #@item.MaBaiViet
                                    </td>

                                    <td class="ql-title">
                                        @item.TieuDe
                                    </td>

                                    <td class="ql-author">
                                        @item.MaNhanVienTacGia
                                    </td>

                                    <td>
                                        <span class="ql-category">
                                            @item.MaDanhMuc
                                        </span>
                                    </td>

                                    <td>
                                        @if (item.TrangThai == "Hoàn Thành")
                                        {
                                            <span class="ql-status status-hoanthanh">
                                                <i class="bi bi-circle-fill"></i>
                                                Hoàn Thành
                                            </span>
                                        }
                                        else if (item.TrangThai == "Chờ Duyệt")
                                        {
                                            <span class="ql-status status-choduyet">
                                                <i class="bi bi-circle-fill"></i>
                                                Chờ Duyệt
                                            </span>
                                        }
                                        else if (item.TrangThai == "Cần Sửa")
                                        {
                                            <span class="ql-status status-cansua">
                                                <i class="bi bi-circle-fill"></i>
                                                Cần Sửa
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="ql-status status-default">
                                                <i class="bi bi-circle-fill"></i>
                                                @item.TrangThai
                                            </span>
                                        }
                                    </td>

                                    <td class="ql-date">
                                        @item.NgayTao.ToString("dd/MM/yyyy")
                                    </td>

                                    @if (laBienTapVien || laChuBien || laQuanTriVien)
                                    {
                                        <td>
                                            <div class="ql-actions">
                                                @if (laBienTapVien || laChuBien)
                                                {
                                                    <a asp-controller="Quanlybaiviet"
                                                       asp-action="Sua"
                                                       asp-route-id="@item.MaBaiViet"
                                                       class="ql-action ql-action-edit">
                                                        <i class="bi bi-pencil-square"></i>
                                                        Sửa
                                                    </a>
                                                }

                                                @if (laQuanTriVien)
                                                {
                                                    <a asp-controller="Quanlybaiviet"
                                                       asp-action="Xoa"
                                                       asp-route-id="@item.MaBaiViet"
                                                       class="ql-action ql-action-delete">
                                                        <i class="bi bi-trash"></i>
                                                        Xóa
                                                    </a>
                                                }
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="@soCot" class="ql-empty">
                                    <i class="bi bi-folder2-open"></i>
                                    <strong>Không tìm thấy bài viết</strong>
                                    <span>
                                        Hãy thử tìm kiếm bằng từ khóa khác.
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="ql-footer">
                <span>
                    <i class="bi bi-info-circle me-1"></i>
                    Danh sách bài viết trong hệ thống
                </span>

                @if (bang != null)
                {
                    <span>
                        Tổng số:
                        <strong>@bang.Count bài viết</strong>
                    </span>
                }
            </div>

        </div>
    </div>
</div>