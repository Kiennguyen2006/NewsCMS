@{
    Layout = "~/Views/Shared/_AdminLTELayout.cshtml";
}
@{
    ViewData["Title"] = "Sửa bài viết";

    var baiViet = ViewBag.bangcu as NewsCMS.Models.BaiVietModel;
    var bangdm = ViewBag.bangdm;

    int maVaiTro = Context.Session.GetInt32("MaVaiTro") ?? 0;
    bool laChuBien = maVaiTro == 3;

    string anh = baiViet?.AnhDaiDien ?? "";
    string duongDanAnh = string.IsNullOrEmpty(anh)
        ? ""
        : (anh.StartsWith("/") ? anh : "/images/" + anh);
}

<link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css"
      rel="stylesheet" />

<style>
    .edit-container {
        max-width: 1100px;
        margin: 25px auto;
    }

    .edit-card {
        background: #131b2e;
        border: 1px solid #23314d;
        border-radius: 16px;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.35);
        overflow: hidden;
    }

    .edit-header {
        background: linear-gradient(135deg, rgba(2, 132, 199, 0.25), rgba(37, 99, 235, 0.25));
        border-bottom: 1px solid rgba(56, 189, 248, 0.3);
        color: #f8fafc;
        padding: 22px 28px;
    }

        .edit-header h4 {
            margin: 0;
            font-weight: 800;
            font-size: 20px;
        }

            .edit-header h4 i {
                color: #38bdf8;
                margin-right: 8px;
            }

    .edit-body {
        padding: 30px;
    }

    .form-label {
        color: #cbd5e1;
        font-weight: 600;
        font-size: 14px;
        margin-bottom: 8px;
    }

    .form-control,
    .form-select {
        background-color: #1a243d !important;
        border: 1px solid #2a3a5c !important;
        color: #f1f5f9 !important;
        border-radius: 10px;
        padding: 11px 14px;
        font-size: 14px;
        transition: all 0.2s ease;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #38bdf8 !important;
            box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15) !important;
            background-color: #1e2a47 !important;
        }

        .form-control[type="file"]::file-selector-button {
            background: #26354d;
            color: #38bdf8;
            border: none;
            padding: 6px 12px;
            border-radius: 6px;
            margin-right: 12px;
            font-weight: 600;
            cursor: pointer;
        }

    .image-current,
    .image-preview {
        width: 230px;
        height: 150px;
        object-fit: cover;
        border-radius: 10px;
        border: 1px solid #2a3a5c;
    }

    .image-preview {
        margin-top: 12px;
    }

    #editor {
        height: 360px;
        background: #1a243d;
        color: #f1f5f9;
        font-size: 15px;
        border: none;
    }

    .ql-toolbar.ql-snow {
        background: #0f172a;
        border-radius: 10px 10px 0 0;
        border: 1px solid #2a3a5c !important;
    }

    .ql-container.ql-snow {
        border-radius: 0 0 10px 10px;
        border: 1px solid #2a3a5c !important;
        border-top: none !important;
    }

    .ql-snow .ql-stroke {
        stroke: #cbd5e1 !important;
    }

    .ql-snow .ql-fill {
        fill: #cbd5e1 !important;
    }

    .ql-snow .ql-picker {
        color: #cbd5e1 !important;
    }

    .ql-snow .ql-picker-options {
        background-color: #1e293b !important;
        border-color: #334155 !important;
    }

    .ql-toolbar button.ql-undo,
    .ql-toolbar button.ql-redo {
        width: 28px;
        font-size: 20px;
        font-weight: bold;
        color: #cbd5e1;
    }

        .ql-toolbar button.ql-undo::before {
            content: "↶";
        }

        .ql-toolbar button.ql-redo::before {
            content: "↷";
        }

        .ql-toolbar button.ql-undo:hover,
        .ql-toolbar button.ql-redo:hover {
            color: #38bdf8;
        }

    .status-view {
        background: #0f172a !important;
        color: #94a3b8 !important;
        font-weight: 600;
    }

    .form-actions {
        display: flex;
        gap: 12px;
        margin-top: 28px;
        padding-top: 20px;
        border-top: 1px solid #23314d;
    }

        .form-actions .btn-slate-primary {
            background: linear-gradient(135deg, #0284c7, #2563eb);
            border: 1px solid rgba(56, 189, 248, 0.4);
            color: #ffffff;
            padding: 11px 24px;
            border-radius: 10px;
            font-weight: 600;
            box-shadow: 0 4px 15px rgba(2, 132, 199, 0.3);
            transition: all 0.2s ease;
        }

            .form-actions .btn-slate-primary:hover {
                opacity: 0.92;
                transform: translateY(-1px);
            }

        .form-actions .btn-slate-secondary {
            background: #1e293b;
            border: 1px solid #334155;
            color: #cbd5e1;
            padding: 11px 22px;
            border-radius: 10px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s ease;
        }

            .form-actions .btn-slate-secondary:hover {
                background: #334155;
                color: #ffffff;
            }

    .field-validation-error, .text-danger {
        color: #f87171 !important;
        font-size: 13px;
    }

    .validation-summary-errors {
        color: #fca5a5;
        background: rgba(239, 68, 68, 0.12);
        border: 1px solid rgba(239, 68, 68, 0.3);
        border-radius: 10px;
        padding: 12px 20px;
        margin-bottom: 20px;
    }

        .validation-summary-errors ul {
            margin-bottom: 0;
        }

    @@media(max-width: 768px) {
        .edit-container {
            padding: 0 10px;
        }

        .edit-body {
            padding: 18px;
        }

        #editor {
            height: 280px;
        }

        .form-actions {
            flex-wrap: wrap;
        }
    }
</style>

@if (baiViet != null)
{
    <div class="container edit-container">
        <div class="edit-card">

            <div class="edit-header">
                <h4>
                    <i class="bi bi-pencil-square"></i>
                    CHỈNH SỬA BÀI VIẾT
                </h4>
            </div>

            <div class="edit-body">

                <form asp-controller="Quanlybaiviet"
                      asp-action="Suabv"
                      method="post"
                      enctype="multipart/form-data"
                      id="formSuaBaiViet">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="MaBaiViet"
                           value="@baiViet.MaBaiViet" />

                    <div asp-validation-summary="All"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Tiêu đề bài viết
                        </label>

                        <input type="text"
                               name="TieuDe"
                               class="form-control"
                               value="@baiViet.TieuDe"
                               minlength="5"
                               maxlength="250"
                               required />

                        <span class="text-danger"
                              data-valmsg-for="TieuDe">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Tóm tắt bài viết
                        </label>

                        <textarea name="TomTat"
                                  class="form-control"
                                  rows="4"
                                  minlength="10"
                                  maxlength="1000"
                                  required>@baiViet.TomTat</textarea>

                        <span class="text-danger"
                              data-valmsg-for="TomTat">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Ảnh đại diện hiện tại
                        </label>

                        @if (!string.IsNullOrEmpty(anh))
                        {
                            <div class="mb-2">
                                <a href="@duongDanAnh" target="_blank">
                                    <img src="@duongDanAnh"
                                         class="image-current"
                                         alt="Ảnh bài viết hiện tại" />
                                </a>
                            </div>

                            <a href="@duongDanAnh"
                               target="_blank"
                               class="small fw-semibold text-decoration-none"
                               style="color: #38bdf8;">
                                <i class="bi bi-eye me-1"></i>
                                Xem ảnh hiện tại
                            </a>
                        }
                        else
                        {
                            <p class="small" style="color: #64748b;">
                                Bài viết chưa có ảnh đại diện.
                            </p>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Chọn ảnh mới
                        </label>

                        <input type="file"
                               name="anhFile"
                               id="anhFile"
                               class="form-control"
                               accept="image/*" />

                        <div id="previewAnh"></div>

                        <small class="d-block mt-1" style="color: #64748b;">
                            Không chọn ảnh mới nếu muốn giữ nguyên ảnh hiện tại.
                        </small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Danh mục bài viết
                        </label>

                        <select name="MaDanhMuc"
                                class="form-select"
                                required>

                            <option value="">
                                -- Chọn danh mục --
                            </option>

                            @if (bangdm != null)
                            {
                                foreach (var dm in bangdm)
                                {
                                    if (dm.MaDanhMuc == baiViet.MaDanhMuc)
                                    {
                                        <option value="@dm.MaDanhMuc" selected>
                                            @dm.TenDanhMuc
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@dm.MaDanhMuc">
                                            @dm.TenDanhMuc
                                        </option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Nội dung bài viết
                        </label>

                        <div id="editor">
                            @Html.Raw(baiViet.NoiDung)
                        </div>

                        <input type="hidden"
                               name="NoiDung"
                               id="NoiDung" />

                        <span class="text-danger"
                              id="loiNoiDung">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Trạng thái bài viết
                        </label>

                        @if (laChuBien)
                        {
                            <select name="TrangThai"
                                    class="form-select"
                                    required>

                                <option value="Chờ Duyệt"
                                        selected="@(baiViet.TrangThai == "Chờ Duyệt")">
                                    Chờ Duyệt
                                </option>

                                <option value="Hoàn Thành"
                                        selected="@(baiViet.TrangThai == "Hoàn Thành")">
                                    Hoàn Thành
                                </option>

                                <option value="Cần Sửa"
                                        selected="@(baiViet.TrangThai == "Cần Sửa")">
                                    Cần Sửa
                                </option>
                            </select>

                            <small class="d-block mt-1" style="color: #34d399;">
                                <i class="bi bi-unlock me-1"></i>
                                Chủ biên được phép thay đổi trạng thái bài viết.
                            </small>
                        }
                        else
                        {
                            <input type="text"
                                   class="form-control status-view"
                                   value="@baiViet.TrangThai"
                                   readonly />

                            <input type="hidden"
                                   name="TrangThai"
                                   value="@baiViet.TrangThai" />

                            <small class="d-block mt-1" style="color: #64748b;">
                                <i class="bi bi-lock me-1"></i>
                                Bạn chỉ được xem trạng thái, không được chỉnh sửa.
                            </small>
                        }
                    </div>

                    <div class="form-actions">

                        <button type="submit"
                                class="btn btn-slate-primary">
                            <i class="bi bi-floppy me-1"></i>
                            Lưu thay đổi
                        </button>

                        <a asp-controller="Quanlybaiviet"
                           asp-action="Quanlybaiviet"
                           class="btn btn-slate-secondary">
                            <i class="bi bi-arrow-left me-1"></i>
                            Quay lại
                        </a>

                    </div>

                </form>
            </div>
        </div>
    </div>
}
else
{
    <div class="container mt-4">
        <div class="alert rounded-3 p-4 mb-3" style="background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171;">
            Không tìm thấy thông tin bài viết.
        </div>

        <a asp-controller="Quanlybaiviet"
           asp-action="Quanlybaiviet"
           class="btn btn-secondary">
            Quay lại
        </a>
    </div>
}

<script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>

<script>
    var editorElement = document.getElementById('editor');

    if (editorElement) {

        var quill = new Quill('#editor', {
            theme: 'snow',

            modules: {

                toolbar: {
                    container: [
                        [{ header: [1, 2, 3, false] }],
                        ['bold', 'italic', 'underline', 'strike'],
                        [
                            { color: [] },
                            { background: [] }
                        ],
                        [
                            { list: 'ordered' },
                            { list: 'bullet' }
                        ],
                        [{ align: [] }],
                        ['link'],
                        ['blockquote'],
                        ['undo', 'redo'],
                        ['clean']
                    ],

                    handlers: {

                        undo: function () {
                            this.quill.history.undo();
                        },

                        redo: function () {
                            this.quill.history.redo();
                        }
                    }
                },
                history: {
                    delay: 1000,
                    maxStack: 100,
                    userOnly: true
                }
            }
        });
        var nutUndo = document.querySelector('.ql-undo');
        var nutRedo = document.querySelector('.ql-redo');
        if (nutUndo) {
            nutUndo.title = 'Hoàn tác thao tác trước';
            nutUndo.setAttribute('aria-label', 'Hoàn tác');
        }

        if (nutRedo) {
            nutRedo.title = 'Làm lại thao tác vừa hoàn tác';
            nutRedo.setAttribute('aria-label', 'Làm lại');
        }
        document.getElementById('formSuaBaiViet')
            .addEventListener('submit', function (e) {

                var noiDung = quill.root.innerHTML;
                var noiDungText = quill.getText().trim();
                document.getElementById('NoiDung').value = noiDung;
                if (noiDungText.length < 20) {
                    e.preventDefault();
                    document.getElementById('loiNoiDung').innerText =
                        'Nội dung bài viết phải có ít nhất 20 ký tự.';
                    return;
                }
                document.getElementById('loiNoiDung').innerText = '';
            });
    }
    var inputAnh = document.getElementById('anhFile');
    if (inputAnh) {
        inputAnh.addEventListener('change', function (e) {

            var file = e.target.files[0];
            var preview = document.getElementById('previewAnh');

            preview.innerHTML = '';

            if (file) {

                if (!file.type.startsWith('image/')) {
                    alert('Vui lòng chọn một tệp hình ảnh.');
                    inputAnh.value = '';
                    return;
                }

                var reader = new FileReader();

                reader.onload = function (event) {

                    var img = document.createElement('img');

                    img.src = event.target.result;
                    img.className = 'image-preview';
                    img.alt = 'Ảnh xem trước';

                    preview.appendChild(img);
                };

                reader.readAsDataURL(file);
            }
        });
    }
</script>