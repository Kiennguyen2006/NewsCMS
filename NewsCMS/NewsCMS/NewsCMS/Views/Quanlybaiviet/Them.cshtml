@{
    Layout = "~/Views/Shared/_AdminLTELayout.cshtml";
}
@model NewsCMS.Models.BaiVietModel

@{
    ViewData["Title"] = "Thêm bài viết";

    int maVaiTro = Context.Session.GetInt32("MaVaiTro") ?? 0;
    bool laBienTapVien = maVaiTro == 2;

    var danhMuc = ViewBag.bangdm;
}

@if (!laBienTapVien)
{
    <div class="container mt-4">
        <div class="alert rounded-3 p-4" style="background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171;">
            <i class="bi bi-shield-exclamation me-2"></i>
            Bạn không có quyền truy cập chức năng thêm bài viết.
        </div>
    </div>
}
else
{
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css"
          rel="stylesheet" />

    <style>
        .article-container {
            min-height: 100vh;
            padding: 20px 15px;
        }

        .article-card {
            max-width: 1100px;
            margin: auto;
            background: #131b2e;
            border: 1px solid #23314d;
            padding: 32px;
            border-radius: 16px;
            box-shadow: 0 12px 35px rgba(0, 0, 0, 0.35);
        }

        .article-header {
            border-bottom: 1px solid #23314d;
            padding-bottom: 18px;
            margin-bottom: 26px;
        }

            .article-header h2 {
                font-weight: 800;
                color: #f8fafc;
                font-size: 23px;
                margin-bottom: 6px;
            }

                .article-header h2 i {
                    color: #38bdf8;
                    margin-right: 8px;
                }

            .article-header p {
                color: #94a3b8;
                font-size: 14px;
                margin: 0;
            }

        .form-label, .editor-label {
            font-weight: 600;
            color: #cbd5e1;
            font-size: 14px;
            margin-bottom: 8px;
        }

        .form-control, .form-select {
            background-color: #1a243d !important;
            border: 1px solid #2a3a5c !important;
            color: #f1f5f9 !important;
            padding: 11px 14px;
            border-radius: 10px;
            font-size: 14px;
            transition: all 0.2s ease;
        }

            .form-control:focus, .form-select:focus {
                border-color: #38bdf8 !important;
                box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15) !important;
                background-color: #1e2a47 !important;
            }

            .form-control::placeholder {
                color: #64748b;
            }

            .form-control[type="file"]::file-selector-button {
                background: #26354d;
                color: #38bdf8;
                border: none;
                padding: 6px 12px;
                border-radius: 6px;
                margin-right: 12px;
                font-weight: 600;
                cursor: pointer;
            }

        #editor {
            height: 360px;
            background: #1a243d;
            color: #f1f5f9;
            font-size: 15px;
            border: none;
        }

        .ql-toolbar.ql-snow {
            border-radius: 10px 10px 0 0;
            background: #0f172a;
            border: 1px solid #2a3a5c !important;
        }

        .ql-container.ql-snow {
            border-radius: 0 0 10px 10px;
            border: 1px solid #2a3a5c !important;
            border-top: none !important;
        }

        .ql-snow .ql-stroke {
            stroke: #cbd5e1 !important;
        }

        .ql-snow .ql-fill {
            fill: #cbd5e1 !important;
        }

        .ql-snow .ql-picker {
            color: #cbd5e1 !important;
        }

        .ql-snow .ql-picker-options {
            background-color: #1e293b !important;
            border-color: #334155 !important;
        }

        .ql-editor.ql-blank::before {
            color: #64748b !important;
            font-style: normal;
        }

        .ql-toolbar button.ql-undo,
        .ql-toolbar button.ql-redo {
            width: 28px;
            font-size: 20px;
            font-weight: bold;
            color: #cbd5e1;
        }

            .ql-toolbar button.ql-undo::before {
                content: "↶";
            }

            .ql-toolbar button.ql-redo::before {
                content: "↷";
            }

            .ql-toolbar button.ql-undo:hover,
            .ql-toolbar button.ql-redo:hover {
                color: #38bdf8;
            }

        .article-actions {
            display: flex;
            justify-content: flex-end;
            gap: 12px;
            margin-top: 28px;
            padding-top: 20px;
            border-top: 1px solid #23314d;
        }

        .btn-save {
            background: linear-gradient(135deg, #059669, #10b981);
            border: 1px solid rgba(52, 211, 153, 0.4);
            color: white;
            padding: 11px 24px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 14px;
            box-shadow: 0 4px 15px rgba(16, 185, 129, 0.25);
            transition: all 0.2s ease;
        }

            .btn-save:hover {
                opacity: 0.92;
                transform: translateY(-1px);
            }

        .btn-back {
            background: #1e293b;
            border: 1px solid #334155;
            color: #cbd5e1;
            padding: 11px 22px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 14px;
            text-decoration: none;
            transition: all 0.2s ease;
        }

            .btn-back:hover {
                background: #334155;
                color: #ffffff;
            }

        .text-danger {
            font-size: 13px;
            color: #f87171 !important;
        }

        .image-preview {
            display: none;
            margin-top: 15px;
            max-width: 300px;
            max-height: 200px;
            object-fit: cover;
            border-radius: 10px;
            border: 1px solid #2a3a5c;
        }

        @@media(max-width: 768px) {
            .article-container {
                padding: 12px;
            }

            .article-card {
                padding: 20px;
            }

            #editor {
                height: 280px;
            }
        }
    </style>

    <div class="article-container">
        <div class="article-card">

            <div class="article-header">
                <h2>
                    <i class="bi bi-pencil-square"></i>
                    Thêm bài viết mới
                </h2>

                <p>
                    Nhập thông tin và soạn thảo nội dung bài viết
                </p>
            </div>

            <form asp-controller="Quanlybaiviet"
                  asp-action="Thembv"
                  method="post"
                  enctype="multipart/form-data"
                  id="formThemBaiViet">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="TieuDe" class="form-label">
                        Tiêu đề bài viết
                    </label>

                    <input asp-for="TieuDe"
                           class="form-control"
                           placeholder="Nhập tiêu đề bài viết..." />

                    <span asp-validation-for="TieuDe"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TomTat" class="form-label">
                        Tóm tắt bài viết
                    </label>

                    <textarea asp-for="TomTat"
                              class="form-control"
                              rows="3"
                              placeholder="Nhập nội dung tóm tắt..."></textarea>

                    <span asp-validation-for="TomTat"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Ảnh đại diện bài viết
                    </label>

                    <input type="file"
                           name="anhFile"
                           id="AnhDaiDienFile"
                           class="form-control"
                           accept="image/*"
                           required />

                    <span class="small d-block mt-1" style="color: #64748b;">
                        Chọn ảnh từ máy tính của bạn.
                    </span>

                    <div>
                        <img id="imagePreview"
                             class="image-preview"
                             alt="Ảnh xem trước" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="MaDanhMuc" class="form-label">
                        Danh mục bài viết
                    </label>

                    <select asp-for="MaDanhMuc"
                            class="form-select">

                        <option value="">-- Chọn danh mục bài viết --</option>

                        @if (danhMuc != null)
                        {
                            foreach (var item in danhMuc)
                            {
                                <option value="@item.MaDanhMuc">
                                    @item.TenDanhMuc
                                </option>
                            }
                        }
                    </select>

                    <span asp-validation-for="MaDanhMuc"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <div class="editor-label">
                        Nội dung bài viết
                    </div>

                    <div id="editor"></div>

                    <input asp-for="NoiDung"
                           type="hidden"
                           id="NoiDung" />

                    <span asp-validation-for="NoiDung"
                          class="text-danger"></span>
                </div>

                <div class="article-actions">

                    <a asp-controller="Quanlybaiviet"
                       asp-action="Quanlybaiviet"
                       class="btn-back">
                        <i class="bi bi-arrow-left me-1"></i>
                        Quay lại
                    </a>

                    <button type="submit" class="btn-save">
                        <i class="bi bi-floppy me-1"></i>
                        Lưu bài viết
                    </button>

                </div>

            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>

    <script>
        const quill = new Quill('#editor', {
            theme: 'snow',

            placeholder: 'Bắt đầu soạn thảo nội dung bài viết...',

            modules: {
                toolbar: {
                    container: [
                        [{ 'header': [1, 2, 3, false] }],
                        [{ 'font': [] }],
                        [{ 'size': ['small', false, 'large', 'huge'] }],
                        ['bold', 'italic', 'underline', 'strike'],
                        [
                            { 'color': [] },
                            { 'background': [] }
                        ],
                        [
                            { 'list': 'ordered' },
                            { 'list': 'bullet' }
                        ],
                        [{ 'align': [] }],
                        ['link'],
                        ['blockquote'],
                        ['undo', 'redo'],
                        ['clean']
                    ],

                    handlers: {
                        undo: function () {
                            this.quill.history.undo();
                        },

                        redo: function () {
                            this.quill.history.redo();
                        }
                    }
                },
                history: {
                    delay: 1000,
                    maxStack: 100,
                    userOnly: true
                }
            }
        });
        const noiDungCu = document.getElementById('NoiDung').value;

        if (noiDungCu) {
            quill.root.innerHTML = noiDungCu;
        }
        document.getElementById('AnhDaiDienFile')
            .addEventListener('change', function (event) {

                const file = event.target.files[0];
                const preview = document.getElementById('imagePreview');

                if (file) {
                    if (!file.type.startsWith('image/')) {
                        alert('Vui lòng chọn một tệp hình ảnh.');
                        event.target.value = '';
                        preview.style.display = 'none';
                        preview.removeAttribute('src');
                        return;
                    }

                    const reader = new FileReader();

                    reader.onload = function (e) {
                        preview.src = e.target.result;
                        preview.style.display = 'block';
                    };

                    reader.readAsDataURL(file);
                }
                else {
                    preview.style.display = 'none';
                    preview.removeAttribute('src');
                }
            });
        document.getElementById('formThemBaiViet')
            .addEventListener('submit', function () {

                document.getElementById('NoiDung').value =
                    quill.root.innerHTML;

            });
    </script>
}