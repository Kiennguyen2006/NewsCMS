@using NewsCMS.Models

@{
    var dongtk = ViewBag.dongtk as TaiKhoanModel;
    var dongdg = ViewBag.dongdg as DocgiaModel;
}

<style>
    .hoso-content {
        max-width: 480px;
        margin: 15px auto;
        background: #131b2e;
        border: 1px solid #23314d;
        border-radius: 14px;
        padding: 20px 24px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.35);
        color: #f1f5f9;
    }

    .hoso-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding-bottom: 14px;
        border-bottom: 1px solid #23314d;
        margin-bottom: 16px;
    }

        .hoso-header i {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: rgba(56, 189, 248, 0.15);
            border: 1px solid rgba(56, 189, 248, 0.3);
            color: #38bdf8;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .hoso-header h5 {
            margin: 0 0 2px 0;
            font-weight: 800;
            font-size: 17px;
            color: #f8fafc;
        }

        .hoso-header small {
            color: #94a3b8;
            font-size: 12px;
        }

    .hoso-title {
        color: #38bdf8;
        font-weight: 700;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        margin-bottom: 10px;
    }

    .hoso-field {
        margin-bottom: 10px;
    }

        .hoso-field label {
            display: block;
            color: #cbd5e1;
            font-weight: 600;
            font-size: 12.5px;
            margin-bottom: 4px;
        }

        .hoso-field .form-control {
            background-color: #1a243d !important;
            border: 1px solid #2a3a5c !important;
            color: #f1f5f9 !important;
            border-radius: 8px !important;
            padding: 7px 12px !important;
            font-size: 13px;
            height: auto;
        }

            .hoso-field .form-control:focus {
                border-color: #38bdf8 !important;
                box-shadow: 0 0 0 2px rgba(56, 189, 248, 0.15) !important;
            }

    .hoso-divider {
        border: 0;
        border-top: 1px solid #23314d;
        margin: 16px 0;
        opacity: 1;
    }

    .hoso-alert-warning {
        background: rgba(245, 158, 11, 0.12);
        border: 1px solid rgba(245, 158, 11, 0.3);
        color: #fbbf24;
        border-radius: 8px;
        padding: 10px 12px;
        font-size: 13px;
    }

    .hoso-logout {
        width: 100%;
        background: linear-gradient(135deg, #dc2626, #b91c1c);
        border: 1px solid rgba(248, 113, 113, 0.4);
        color: #ffffff;
        border-radius: 8px;
        padding: 9px 18px;
        font-weight: 600;
        font-size: 13px;
        box-shadow: 0 4px 12px rgba(220, 38, 38, 0.25);
        transition: all 0.2s ease;
        cursor: pointer;
    }

        .hoso-logout:hover {
            background: linear-gradient(135deg, #ef4444, #dc2626);
            transform: translateY(-1px);
        }

    @@media (max-width: 520px) {
        .hoso-content {
            margin: 10px;
            padding: 16px;
        }
    }
</style>

<div class="hoso-content">

    <div class="hoso-header">
        <i class="bi bi-person-circle"></i>
        <div>
            <h5>Hồ sơ cá nhân</h5>
            <small>Thông tin tài khoản của bạn</small>
        </div>
    </div>

    @if (dongtk != null)
    {
        <h6 class="hoso-title">Thông tin tài khoản</h6>

        <div class="hoso-field">
            <label>Mã tài khoản</label>
            <input class="form-control"
                   value="TK-@dongtk.MaTaiKhoan" readonly />
        </div>

        <div class="hoso-field">
            <label>Tên đăng nhập</label>
            <input class="form-control"
                   value="@dongtk.TenDangNhap" readonly />
        </div>

        <div class="hoso-field">
            <label>Email</label>
            <input class="form-control"
                   value="@dongtk.Email" readonly />
        </div>
    }

    <hr class="hoso-divider" />

    <h6 class="hoso-title">Thông tin độc giả</h6>

    @if (dongdg != null)
    {
        <div class="hoso-field">
            <label>Mã độc giả</label>
            <input class="form-control"
                   value="DG-@dongdg.MaDocGia" readonly />
        </div>

        <div class="hoso-field">
            <label>Họ và tên</label>
            <input class="form-control"
                   value="@dongdg.HoTen" readonly />
        </div>

        <div class="hoso-field">
            <label>Ngày đăng ký</label>
            <input class="form-control"
                   value="@dongdg.NgayDangKy.ToString("dd/MM/yyyy")"
                   readonly />
        </div>
    }
    else
    {
        <div class="hoso-alert-warning">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            Không tìm thấy thông tin độc giả.
        </div>
    }

    <hr class="hoso-divider" />

    <form asp-controller="Hoso"
          asp-action="Dangxuat"
          method="post">

        @Html.AntiForgeryToken()

        <button type="submit" class="hoso-logout"
                onclick="return confirm('Bạn có chắc chắn muốn đăng xuất không?')">
            <i class="bi bi-box-arrow-right me-1"></i>
            Đăng xuất
        </button>

    </form>

</div>