@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', sans-serif;
        background: #0f172a;
        min-height: 100vh;
        position: relative;
        overflow-x: hidden;
    }

    .snowflake, .star-dust {
        position: fixed;
        top: -20px;
        z-index: 99999;
        user-select: none;
        pointer-events: none;
        animation: fall linear infinite;
    }

    .snowflake {
        color: #93c5fd;
        text-shadow: 0 0 6px rgba(147, 197, 253, 0.6);
    }

    .star-dust {
        color: #38bdf8;
        text-shadow: 0 0 8px rgba(56, 189, 248, 0.8);
        font-size: 11px;
    }

    @@keyframes fall {
        0% {
            transform: translateY(-20px) translateX(0) rotate(0deg);
            opacity: 0.9;
        }

        50% {
            transform: translateY(50vh) translateX(15px) rotate(180deg);
            opacity: 0.5;
        }

        100% {
            transform: translateY(105vh) translateX(-15px) rotate(360deg);
            opacity: 0.1;
        }
    }

    .reset-page {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 25px;
        position: relative;
        z-index: 2;
    }

    .reset-card {
        width: 100%;
        max-width: 430px;
        padding: 42px 38px;
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 22px;
        box-shadow: 0 25px 70px rgba(0, 0, 0, 0.4);
        position: relative;
        z-index: 1;
        animation: appear 0.8s ease forwards;
        color: #f8fafc;
    }

    .reset-header {
        text-align: center;
        margin-bottom: 32px;
    }

    .reset-logo {
        width: 65px;
        height: 65px;
        margin: 0 auto 18px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #1e3a8a, #2563eb);
        color: white;
        font-size: 27px;
        font-weight: bold;
        box-shadow: 0 8px 20px rgba(37, 99, 235, 0.3);
    }

    .reset-header h2 {
        color: #f8fafc;
        font-size: 26px;
        margin-bottom: 9px;
        font-weight: 800;
    }

    .reset-header p {
        color: #94a3b8;
        font-size: 14px;
        line-height: 1.6;
    }

    .form-group {
        margin-bottom: 22px;
    }

        .form-group label {
            display: block;
            color: #cbd5e1;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 9px;
        }

    .input-box input {
        width: 100%;
        height: 51px;
        padding: 0 15px;
        border: 1.5px solid #475569;
        border-radius: 11px;
        outline: none;
        font-size: 14px;
        color: #f8fafc;
        background: #0f172a;
        transition: all 0.3s ease;
    }

        .input-box input:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.2);
        }

    .reset-message {
        padding: 12px;
        margin-bottom: 20px;
        border-radius: 9px;
        background: rgba(239, 68, 68, 0.2);
        border: 1px solid #f87171;
        color: #fca5a5;
        font-size: 13px;
        text-align: center;
    }

    .reset-button {
        width: 100%;
        height: 51px;
        border: none;
        border-radius: 11px;
        color: white;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        background: linear-gradient(135deg, #1e3a8a, #2563eb);
        box-shadow: 0 8px 18px rgba(37, 99, 235, 0.3);
        transition: all 0.3s ease;
        margin-top: 8px;
    }

        .reset-button:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 25px rgba(37, 99, 235, 0.4);
        }

    .reset-footer {
        text-align: center;
        margin-top: 28px;
        color: #64748b;
        font-size: 12px;
    }

    @@keyframes appear {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="reset-page">
    <div class="reset-card">
        <div class="reset-header">
            <div class="reset-logo">N</div>
            <h2>Đặt lại mật khẩu</h2>
            <p>Vui lòng nhập mật khẩu mới để hoàn tất quá trình khôi phục tài khoản NewsCMS.</p>
        </div>

        <form method="post" asp-controller="Trangchu" asp-action="Taolaimk">
            @if (ViewBag.thongbao != null)
            {
                <div class="reset-message">@ViewBag.thongbao</div>
            }

            <div class="form-group">
                <label for="MatKhauMoi">Mật khẩu mới</label>
                <div class="input-box">
                    <input type="password" id="MatKhauMoi" name="MatKhauMoi" placeholder="Nhập mật khẩu mới" autocomplete="new-password" required />
                </div>
            </div>

            <div class="form-group">
                <label for="XacNhanMatKhau">Xác nhận mật khẩu</label>
                <div class="input-box">
                    <input type="password" id="XacNhanMatKhau" name="XacNhanMatKhau" placeholder="Nhập lại mật khẩu mới" autocomplete="new-password" required />
                </div>
            </div>

            <button type="submit" class="reset-button">Xác nhận đổi mật khẩu</button>
        </form>

        <div class="reset-footer">© 2026 NewsCMS. All rights reserved.</div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const count = 35;
        for (let i = 0; i < count; i++) {
            const snow = document.createElement('div');
            snow.classList.add('snowflake');
            snow.innerHTML = i % 2 === 0 ? '❄' : '❅';
            snow.style.left = Math.random() * window.innerWidth + 'px';
            snow.style.top = -20 + Math.random() * -100 + 'px';
            snow.style.fontSize = (Math.random() * 10 + 10) + 'px';
            snow.style.opacity = Math.random() * 0.7 + 0.3;
            snow.style.animationDuration = (Math.random() * 6 + 4) + 's';
            snow.style.animationDelay = (Math.random() * 5) + 's';
            document.body.appendChild(snow);

            const star = document.createElement('div');
            star.classList.add('star-dust');
            star.innerHTML = '✦';
            star.style.left = Math.random() * window.innerWidth + 'px';
            star.style.top = -20 + Math.random() * -100 + 'px';
            star.style.fontSize = (Math.random() * 8 + 8) + 'px';
            star.style.opacity = Math.random() * 0.8 + 0.2;
            star.style.animationDuration = (Math.random() * 5 + 3) + 's';
            star.style.animationDelay = (Math.random() * 4) + 's';
            document.body.appendChild(star);
        }
    });
</script>