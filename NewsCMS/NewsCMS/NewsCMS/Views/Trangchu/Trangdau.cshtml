@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            function createSnowAndStars() {
                const count = 40;
                for (let i = 0; i < count; i++) {
                    const snow = document.createElement('div');
                    snow.classList.add('snowflake');
                    snow.innerHTML = i % 2 === 0 ? '❄' : '❅';
                    snow.style.left = Math.random() * window.innerWidth + 'px';
                    snow.style.top = -20 + Math.random() * -100 + 'px';
                    snow.style.fontSize = (Math.random() * 10 + 10) + 'px';
                    snow.style.opacity = Math.random() * 0.7 + 0.3;
                    snow.style.animationDuration = (Math.random() * 6 + 4) + 's';
                    snow.style.animationDelay = (Math.random() * 5) + 's';
                    document.body.appendChild(snow);

                    const star = document.createElement('div');
                    star.classList.add('star-dust');
                    star.innerHTML = '✦';
                    star.style.left = Math.random() * window.innerWidth + 'px';
                    star.style.top = -20 + Math.random() * -100 + 'px';
                    star.style.fontSize = (Math.random() * 8 + 8) + 'px';
                    star.style.opacity = Math.random() * 0.8 + 0.2;
                    star.style.animationDuration = (Math.random() * 5 + 3) + 's';
                    star.style.animationDelay = (Math.random() * 4) + 's';
                    document.body.appendChild(star);
                }
            }
            createSnowAndStars();

            const newsContent = document.getElementById('newsContent');
            const searchForm = document.getElementById('newsSearch');
            const btnHoso = document.getElementById('btnHoso');
            const khungHoso = document.getElementById('khungHoso');

            if (btnHoso && khungHoso) {
                btnHoso.addEventListener('click', async function (event) {
                    event.stopPropagation();
                    if (khungHoso.classList.contains('show')) {
                        khungHoso.classList.remove('show');
                        btnHoso.setAttribute('aria-expanded', 'false');
                        return;
                    }
                    khungHoso.classList.add('show');
                    btnHoso.setAttribute('aria-expanded', 'true');
                    if (khungHoso.dataset.loaded === 'true') return;
                    khungHoso.innerHTML = '<div class="p-3 text-center">Đang tải thông tin...</div>';
                    try {
                        const response = await fetch(btnHoso.dataset.url);
                        if (response.status === 401) { window.location.href = '/Trangchu/Dangnhap'; return; }
                        if (!response.ok) throw new Error('Không thể tải hồ sơ.');
                        khungHoso.innerHTML = await response.text();
                        khungHoso.dataset.loaded = 'true';
                    } catch (error) {
                        khungHoso.innerHTML = '<div class="p-3 text-danger">Không thể tải thông tin hồ sơ.</div>';
                    }
                });
                document.addEventListener('click', function (event) {
                    if (!khungHoso.contains(event.target) && !btnHoso.contains(event.target)) {
                        khungHoso.classList.remove('show');
                        btnHoso.setAttribute('aria-expanded', 'false');
                    }
                });
            }

            if (!newsContent) return;

            async function loadPage(url, addHistory = true) {
                newsContent.style.opacity = '0.5';
                try {
                    const response = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    if (!response.ok) throw new Error('Không thể tải trang.');
                    const html = await response.text();
                    const parser = new DOMParser();
                    const newDocument = parser.parseFromString(html, 'text/html');
                    const newContent = newDocument.getElementById('newsContent');
                    if (!newContent) { window.location.href = url; return; }
                    newsContent.innerHTML = newContent.innerHTML;
                    if (newDocument.title) document.title = newDocument.title;
                    if (addHistory) window.history.pushState({}, '', url);
                    updateCategoryActive(url);
                    newsContent.style.opacity = '1';
                    window.scrollTo({ top: newsContent.getBoundingClientRect().top + window.scrollY - 110, behavior: 'smooth' });
                } catch (error) {
                    newsContent.style.opacity = '1';
                    window.location.href = url;
                }
            }

            function updateCategoryActive(url) {
                const currentUrl = new URL(url, window.location.origin);
                const currentCategory = currentUrl.searchParams.get('maDanhMuc') || '';
                document.querySelectorAll('.news-navigation .category-link').forEach(link => {
                    const linkUrl = new URL(link.href, window.location.origin);
                    const linkCategory = linkUrl.searchParams.get('maDanhMuc') || '';
                    const isHome = link.classList.contains('category-home');
                    link.classList.toggle('category-active', isHome ? currentCategory === '' : linkCategory === currentCategory);
                });
            }

            document.addEventListener('click', function (event) {
                const link = event.target.closest('.news-navigation .category-link, .news-pagination a');
                if (!link || !link.href) return;
                if (event.ctrlKey || event.shiftKey || event.altKey || event.metaKey || link.target === '_blank' || link.hasAttribute('download')) return;
                const url = new URL(link.href, window.location.origin);
                if (url.origin !== window.location.origin) return;
                event.preventDefault();
                loadPage(url.href);
            });

            if (searchForm) {
                searchForm.addEventListener('submit', function (event) {
                    event.preventDefault();
                    const formData = new FormData(searchForm);
                    const params = new URLSearchParams(formData);
                    const url = new URL(searchForm.action, window.location.origin);
                    url.search = params.toString();
                    loadPage(url.href);
                });
            }

            window.addEventListener('popstate', function () { loadPage(window.location.href, false); });
        });
    </script>
}