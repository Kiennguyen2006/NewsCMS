@using Microsoft.AspNetCore.Http
@using NewsCMS.Models
@using System.Collections.Generic
@using System.Linq

@section Styles {
    <style>
        * {
            box-sizing: border-box;
        }

        body, .news-page {
            background: radial-gradient(circle at top center, #131c31 0%, #090d16 100%) !important;
            color: #e2e8f0;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            position: relative;
            overflow-x: hidden;
            margin: 0;
        }

        .snowflake, .star-dust {
            position: fixed;
            top: -20px;
            z-index: 99999;
            user-select: none;
            pointer-events: none;
            animation: fall linear infinite;
        }

        .snowflake {
            color: #bae6fd;
            text-shadow: 0 0 8px rgba(186, 230, 253, 0.7);
        }

        .star-dust {
            color: #38bdf8;
            text-shadow: 0 0 10px rgba(56, 189, 248, 0.9);
            font-size: 11px;
        }

        @@keyframes fall {
            0% {
                transform: translateY(-20px) translateX(0) rotate(0deg);
                opacity: 0.9;
            }

            50% {
                transform: translateY(50vh) translateX(15px) rotate(180deg);
                opacity: 0.5;
            }

            100% {
                transform: translateY(105vh) translateX(-15px) rotate(360deg);
                opacity: 0.1;
            }
        }

        .noel-corner-left, .noel-corner-right {
            position: fixed;
            bottom: 20px;
            z-index: 9998;
            pointer-events: none;
            font-size: 42px;
            filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.7));
            animation: bounceCorner 3s ease-in-out infinite alternate;
        }

        .noel-corner-left {
            left: 20px;
        }

        .noel-corner-right {
            right: 20px;
            animation-delay: 1.5s;
        }

        @@keyframes bounceCorner {
            from {
                transform: translateY(0);
            }

            to {
                transform: translateY(-8px);
            }
        }

        .news-header {
            background: rgba(15, 23, 42, 0.85) !important;
            backdrop-filter: blur(12px);
            border-bottom: 1px solid #1e293b;
            box-shadow: 0 4px 25px rgba(0, 0, 0, 0.35);
            padding: 14px 0;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .news-header-inner {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }

        .news-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            font-size: 22px;
            font-weight: 800;
            color: #f8fafc !important;
        }

            .news-logo img {
                width: 38px;
                height: 38px;
                object-fit: contain;
                border-radius: 8px;
            }

            .news-logo span .logo-blue {
                color: #38bdf8;
            }

        .news-search {
            flex: 1;
            max-width: 480px;
            display: flex;
            background: #1e293b;
            border: 1px solid #334155;
            border-radius: 12px;
            overflow: hidden;
            transition: all 0.3s ease;
        }

            .news-search:focus-within {
                border-color: #38bdf8;
                box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15);
            }

            .news-search input {
                flex: 1;
                height: 42px;
                padding: 0 16px;
                background: transparent;
                border: none;
                outline: none;
                color: #f1f5f9;
                font-size: 14px;
            }

                .news-search input::placeholder {
                    color: #64748b;
                }

            .news-search button {
                background: linear-gradient(135deg, #0284c7, #2563eb);
                color: white;
                border: none;
                padding: 0 18px;
                font-weight: 600;
                cursor: pointer;
                transition: opacity 0.2s;
            }

                .news-search button:hover {
                    opacity: 0.9;
                }

        .news-account {
            display: flex;
            align-items: center;
            gap: 10px;
            position: relative;
        }

        .account-login, .account-register {
            padding: 8px 16px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s;
        }

        .account-login {
            color: #cbd5e1;
            background: #1e293b;
            border: 1px solid #334155;
        }

            .account-login:hover {
                color: #ffffff;
                border-color: #475569;
            }

        .account-register {
            color: white;
            background: linear-gradient(135deg, #0284c7, #2563eb);
        }

            .account-register:hover {
                opacity: 0.9;
            }

        .news-navigation {
            background: #0f172a !important;
            border-bottom: 1px solid #1e293b;
            padding: 8px 0;
        }

        .news-navigation-inner {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 20px;
            display: flex;
            align-items: center;
            gap: 6px;
            overflow-x: auto;
            scrollbar-width: none;
        }

            .news-navigation-inner::-webkit-scrollbar {
                display: none;
            }

        .category-link {
            color: #94a3b8 !important;
            font-weight: 600;
            font-size: 14px;
            padding: 7px 14px;
            border-radius: 8px;
            text-decoration: none;
            white-space: nowrap;
            transition: all 0.2s ease;
        }

            .category-link:hover, .category-link.category-active {
                color: #ffffff !important;
                background: rgba(56, 189, 248, 0.15) !important;
                border: 1px solid rgba(56, 189, 248, 0.3);
            }

        .news-main {
            max-width: 1280px;
            margin: 28px auto;
            padding: 0 20px;
        }

        .news-welcome {
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            border: 1px solid #334155;
            color: #f8fafc;
            border-radius: 18px;
            padding: 36px 40px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
            margin-bottom: 28px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: relative;
            overflow: hidden;
        }

            .news-welcome::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 4px;
                height: 100%;
                background: linear-gradient(to bottom, #38bdf8, #2563eb);
            }

        .welcome-label {
            background: rgba(56, 189, 248, 0.15);
            color: #38bdf8;
            border: 1px solid rgba(56, 189, 248, 0.3);
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1px;
        }

        .news-welcome h1 {
            font-size: 28px;
            font-weight: 800;
            margin: 12px 0 6px;
            color: #ffffff;
        }

        .news-welcome p {
            color: #94a3b8;
            font-size: 15px;
            margin: 0;
        }

        .welcome-decoration {
            font-size: 68px;
            font-weight: 900;
            color: rgba(255, 255, 255, 0.04);
            letter-spacing: 4px;
            user-select: none;
        }

        .news-management {
            background: #131b2e !important;
            border: 1px solid #23314d !important;
            border-radius: 16px;
            padding: 24px;
            margin-bottom: 28px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
        }

        .management-heading {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 18px;
        }

        .section-kicker {
            font-size: 11px;
            font-weight: 700;
            color: #38bdf8;
            letter-spacing: 1.2px;
            text-transform: uppercase;
        }

        .management-heading h2 {
            margin: 4px 0 0;
            font-size: 20px;
            font-weight: 800;
            color: #f8fafc;
        }

        .management-role {
            background: rgba(56, 189, 248, 0.12);
            color: #38bdf8;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 700;
            border: 1px solid rgba(56, 189, 248, 0.25);
        }

        .management-links {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 12px;
        }

        .management-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 14px 16px;
            background: #1a243d;
            border: 1px solid #2a3a5c;
            border-radius: 12px;
            color: #e2e8f0;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.25s ease;
        }

            .management-link:hover {
                background: #223052;
                border-color: #38bdf8;
                color: #ffffff;
                transform: translateY(-2px);
            }

        .management-icon {
            width: 36px;
            height: 36px;
            background: rgba(56, 189, 248, 0.15);
            color: #38bdf8;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        .news-columns {
            display: grid;
            grid-template-columns: 230px 1fr 230px;
            gap: 24px;
            align-items: start;
        }

        @@media (max-width: 1024px) {
            .news-columns {
                grid-template-columns: 1fr;
            }

            .news-ad-column {
                display: none;
            }
        }

        .news-ad-column {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .ad-heading {
            font-size: 11px;
            font-weight: 700;
            color: #64748b;
            letter-spacing: 1.2px;
            margin: 0 0 4px 4px;
        }

        .news-ad-card {
            background: #131b2e !important;
            border: 1px solid #23314d !important;
            border-radius: 14px;
            padding: 8px;
            text-align: center;
            position: relative;
            overflow: hidden;
            transition: all 0.25s;
            min-height: 120px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .news-ad-card:hover {
                border-color: #38bdf8 !important;
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
            }

            .news-ad-card a {
                display: block;
                width: 100%;
                height: 100%;
                text-decoration: none;
            }

            .news-ad-card img {
                width: 100%;
                height: 140px;
                border-radius: 8px;
                display: block;
                object-fit: cover;
            }

        .ad-tag {
            position: absolute;
            top: 12px;
            right: 12px;
            background: rgba(15, 23, 42, 0.85);
            color: #cbd5e1;
            font-size: 9px;
            font-weight: 700;
            padding: 2px 6px;
            border-radius: 4px;
            z-index: 2;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .ad-placeholder {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            color: #64748b;
            font-size: 13px;
            padding: 22px 0;
        }

        .ad-symbol {
            font-size: 18px;
            color: #38bdf8;
        }

        .news-content {
            background: #131b2e !important;
            border: 1px solid #23314d !important;
            border-radius: 18px;
            padding: 30px;
            box-shadow: 0 12px 35px rgba(0, 0, 0, 0.25);
            transition: opacity 0.2s ease;
        }

        .news-section-title {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 24px;
            padding-bottom: 16px;
            border-bottom: 1px solid #23314d;
        }

            .news-section-title h2 {
                margin: 4px 0 0;
                font-size: 22px;
                font-weight: 800;
                color: #f8fafc;
            }

        .news-count {
            font-size: 13px;
            font-weight: 600;
            color: #94a3b8;
            background: #1a243d;
            padding: 6px 12px;
            border-radius: 8px;
            border: 1px solid #2a3a5c;
        }

        .news-article-list {
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        .news-article {
            display: flex;
            gap: 20px;
            padding-bottom: 24px;
            border-bottom: 1px solid #23314d;
            transition: transform 0.2s ease;
        }

            .news-article:last-child {
                border-bottom: none;
                padding-bottom: 0;
            }

            .news-article:hover {
                transform: translateY(-2px);
            }

        .article-image-link {
            flex: 0 0 240px;
            height: 150px;
            border-radius: 12px;
            overflow: hidden;
            background: #1a243d;
            border: 1px solid #2a3a5c;
        }

        .article-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .news-article:hover .article-image {
            transform: scale(1.05);
        }

        .article-image-empty {
            display: flex;
            align-items: center;
            justify-content: center;
            color: #475569;
            font-weight: 700;
            font-size: 14px;
            letter-spacing: 2px;
            height: 100%;
        }

        .article-body {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .article-category {
            font-size: 11px;
            font-weight: 700;
            color: #38bdf8;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            margin-bottom: 6px;
        }

        .article-title {
            margin: 0 0 8px;
            font-size: 18px;
            font-weight: 700;
            line-height: 1.45;
        }

            .article-title a {
                color: #f1f5f9;
                text-decoration: none;
                transition: color 0.2s;
            }

                .article-title a:hover {
                    color: #38bdf8;
                }

        .article-summary {
            font-size: 14px;
            color: #94a3b8;
            line-height: 1.6;
            margin: 0 0 14px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .article-footer {
            margin-top: auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 13px;
        }

        .article-date {
            color: #64748b;
        }

        .article-read-more {
            color: #38bdf8;
            font-weight: 600;
            text-decoration: none;
            transition: color 0.2s;
        }

            .article-read-more:hover {
                color: #7dd3fc;
                text-decoration: underline;
            }

        .news-empty {
            text-align: center;
            padding: 50px 20px;
            color: #94a3b8;
        }

            .news-empty span {
                font-size: 40px;
                display: block;
                margin-bottom: 12px;
                color: #475569;
            }

            .news-empty h3 {
                color: #f8fafc;
                margin-bottom: 6px;
            }

        .news-pagination {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            margin-top: 35px;
            padding-top: 22px;
            border-top: 1px solid #23314d;
        }

        .pagination-caption {
            margin-right: 6px;
            color: #64748b;
            font-size: 14px;
            font-weight: 600;
        }

        .news-pagination .pagination-link {
            display: inline-flex;
            justify-content: center;
            align-items: center;
            min-width: 38px;
            height: 38px;
            padding: 0 12px;
            color: #cbd5e1;
            background: #1a243d;
            border: 1px solid #2a3a5c;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.2s;
        }

            .news-pagination .pagination-link:hover,
            .news-pagination .pagination-link.pagination-active {
                color: #ffffff;
                background: #0284c7;
                border-color: #38bdf8;
            }

        .btn-hoso {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 9px 16px;
            border: 1px solid #334155;
            border-radius: 20px;
            background: #1e293b;
            color: #f8fafc;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }

            .btn-hoso:hover, .btn-hoso[aria-expanded="true"] {
                border-color: #38bdf8;
                background: #26354d;
                color: #ffffff;
            }

        .hoso-dropdown {
            position: absolute;
            top: calc(100% + 12px);
            right: 0;
            width: 340px;
            background: #1e293b;
            border: 1px solid #334155;
            border-radius: 14px;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.45);
            z-index: 9999;
            opacity: 0;
            visibility: hidden;
            transform: translateY(-8px);
            transition: all 0.25s ease;
            color: #f1f5f9;
        }

            .hoso-dropdown.show {
                opacity: 1;
                visibility: visible;
                transform: translateY(0);
            }

        .news-footer {
            background: #060910 !important;
            color: #94a3b8;
            padding: 60px 20px 25px;
            margin-top: 80px;
            border-top: 1px solid #1e293b;
        }

        .footer-container {
            max-width: 1280px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 35px;
            padding-bottom: 40px;
            border-bottom: 1px solid #1e293b;
        }

        .footer-col h4 {
            color: #f8fafc;
            font-size: 15px;
            font-weight: 700;
            margin-bottom: 16px;
            text-transform: uppercase;
            letter-spacing: 0.8px;
        }

        .footer-col p {
            font-size: 14px;
            line-height: 1.6;
            color: #64748b;
            margin-bottom: 15px;
        }

        .footer-links {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .footer-links li {
                margin-bottom: 10px;
            }

            .footer-links a {
                color: #94a3b8;
                text-decoration: none;
                font-size: 14px;
                transition: all 0.2s ease;
            }

                .footer-links a:hover {
                    color: #38bdf8;
                    padding-left: 4px;
                }

        .footer-bottom {
            max-width: 1280px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 25px;
            font-size: 13px;
            color: #475569;
        }

        @@media (max-width: 768px) {
            .footer-bottom {
                flex-direction: column;
                gap: 10px;
                text-align: center;
            }

            .news-article {
                flex-direction: column;
            }

            .article-image-link {
                flex: none;
                width: 100%;
                height: 180px;
            }
        }
    </style>

    <link rel="stylesheet" href="~/css/Trangdau.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = "Trang chủ - NewsCMS";

    var maTaiKhoan = Context.Session.GetInt32("MaTaiKhoan");
    var maVaiTro = Context.Session.GetInt32("MaVaiTro") ?? 0;

    IEnumerable<BaiVietModel> danhSachBaiViet =
        ViewBag.bang as IEnumerable<BaiVietModel>
        ?? Enumerable.Empty<BaiVietModel>();

    danhSachBaiViet = danhSachBaiViet
        .Where(x => x.TrangThai == "Hoàn Thành")
        .ToList();

    int soLuongBaiViet = danhSachBaiViet.Count();
}

<div class="noel-corner-left">🎄</div>
<div class="noel-corner-right">🎁</div>

<div class="news-page">

    <header class="news-header">
        <div class="news-header-inner">
            <a asp-controller="Trangchu" asp-action="Trangdau" class="news-logo">
                <img src="/images/logo.png" alt="NewsCMS" />
                <span>News<span class="logo-blue">CMS</span></span>
            </a>

            <form asp-controller="Trangchu" asp-action="Trangdau" method="get" class="news-search" id="newsSearch">
                <input type="text" name="timkiem" value="@ViewBag.timkiem" placeholder="Nhập tên bài viết muốn tìm..." />
                <button type="submit">⌕ Tìm kiếm</button>
            </form>

            <div class="news-account">
                @if (!maTaiKhoan.HasValue)
                {
                    <a href="/Trangchu/Dangnhap" class="account-login">Đăng nhập</a>
                    <a href="/Trangchu/Dangky" class="account-register">Đăng ký</a>
                }
                else
                {
                    <button type="button" id="btnHoso" class="btn-hoso" data-url="@Url.Action("Hoso", "Hoso")" aria-expanded="false">
                        <i class="fas fa-user-circle"></i> Hồ Sơ <i class="fas fa-chevron-down"></i>
                    </button>
                    <div id="khungHoso" class="hoso-dropdown"></div>
                }
            </div>
        </div>
    </header>

    <nav class="news-navigation">
        <div class="news-navigation-inner">
            <a asp-controller="Trangchu" asp-action="Trangdau" class="category-link category-home">⌂ Trang chủ</a>
            @if (ViewBag.bangdanhmuc != null)
            {
                foreach (var dm in ViewBag.bangdanhmuc)
                {
                    <a asp-controller="Trangchu" asp-action="Trangdau" asp-route-maDanhMuc="@dm.MaDanhMuc" class="category-link @(ViewBag.maDanhMuc == dm.MaDanhMuc ? "category-active" : "")">
                        @dm.TenDanhMuc
                    </a>
                }
            }
        </div>
    </nav>

    <main class="news-main">
        <section class="news-welcome">
            <div>
                <span class="welcome-label">TIN TỨC MỖI NGÀY</span>
                <h1>Cập nhật những tin tức mới nhất</h1>
                <p>Khám phá thông tin nổi bật về công nghệ, kinh tế, giáo dục và đời sống.</p>
            </div>
            <div class="welcome-decoration">NEWS</div>
        </section>

        @if (maTaiKhoan.HasValue && maVaiTro > 0)
        {
            <section class="news-management">
                <div class="management-heading">
                    <div>
                        <span class="section-kicker">KHU VỰC ĐIỀU HÀNH</span>
                        <h2>Quản lý hệ thống</h2>
                    </div>
                    <span class="management-role">
                        @(maVaiTro == 1 ? "Quản trị viên" : maVaiTro == 2 ? "Biên tập viên" : maVaiTro == 3 ? "Chủ biên" : "Người dùng")
                    </span>
                </div>
                <div class="management-links">
                    @if (maVaiTro == 1)
                    {
                        <a asp-controller="Thongke" asp-action="Thongke" class="management-link">
                            <span class="management-icon">▥</span>
                            <span>Thống kê dữ liệu</span>
