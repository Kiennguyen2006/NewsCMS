@using NewsCMS.Models

@{
    ViewData["Title"] = "Chi tiết bài viết";

    var baiviet = ViewBag.dongbaiviet as BaiVietModel;
    var danhsachbinhluan = ViewBag.binhluan as List<BinhluanModel>;
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<style>
    body {
        background: #0b1120;
        color: #f1f5f9;
    }

    .news-page {
        width: 100%;
        max-width: 1540px;
        margin: 35px auto 60px;
        padding: 0 22px;
    }

    .news-page-layout {
        display: grid;
        grid-template-columns: 180px minmax(0, 1020px) 180px;
        justify-content: center;
        align-items: start;
        gap: 24px;
    }

    .side-ad {
        position: sticky;
        top: 25px;
        min-height: 510px;
        padding: 18px 14px;
        border-radius: 16px;
        overflow: hidden;
        text-align: center;
        background: #131b2e;
        border: 1px solid #23314d;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
        animation: fadeUp .8s ease both;
    }

    .side-ad-right {
        animation-delay: .2s;
    }

    .ad-label {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 30px;
        background: rgba(56, 189, 248, 0.12);
        border: 1px solid rgba(56, 189, 248, 0.25);
        color: #38bdf8;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.3px;
    }

    .ad-visual {
        width: 96px;
        height: 96px;
        margin: 28px auto 22px;
        border-radius: 26px;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 38px;
        color: white;
        animation: floatAd 3s ease-in-out infinite;
    }

    .ad-blue {
        background: linear-gradient(135deg, #0284c7, #2563eb);
        box-shadow: 0 12px 25px rgba(2, 132, 199, 0.35);
    }

    .ad-purple {
        background: linear-gradient(135deg, #7c3aed, #4f46e5);
        box-shadow: 0 12px 25px rgba(124, 58, 237, 0.35);
    }

    .ad-title {
        font-size: 18px;
        line-height: 1.45;
        font-weight: 800;
        color: #f8fafc;
        margin-bottom: 12px;
    }

    .ad-description {
        font-size: 13px;
        line-height: 1.75;
        color: #94a3b8;
        margin-bottom: 20px;
    }

    .ad-list {
        text-align: left;
        padding: 0;
        list-style: none;
        margin: 18px 0;
    }

        .ad-list li {
            font-size: 12.5px;
            color: #cbd5e1;
            margin-bottom: 11px;
        }

        .ad-list i {
            color: #38bdf8;
            margin-right: 6px;
        }

    .ad-button {
        display: block;
        padding: 11px 8px;
        background: linear-gradient(135deg, #0284c7, #2563eb);
        border: 1px solid rgba(56, 189, 248, 0.35);
        color: white;
        border-radius: 10px;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
        transition: .3s;
    }

        .ad-button:hover {
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 7px 18px rgba(2, 132, 199, 0.35);
        }

    .ad-button-purple {
        background: linear-gradient(135deg, #7c3aed, #4f46e5);
        border: 1px solid rgba(167, 139, 250, 0.35);
    }

        .ad-button-purple:hover {
            box-shadow: 0 7px 18px rgba(124, 58, 237, 0.35);
        }

    .ad-decoration {
        position: absolute;
        width: 110px;
        height: 110px;
        border-radius: 50%;
        background: rgba(56, 189, 248, 0.06);
        bottom: -55px;
        right: -45px;
        pointer-events: none;
    }
    .news-main {
        min-width: 0;
    }

    .breadcrumb-news {
        font-size: 13px;
        color: #64748b;
        margin-bottom: 18px;
        animation: fadeUp .5s ease both;
    }

        .breadcrumb-news a {
            color: #38bdf8;
            text-decoration: none;
            font-weight: 600;
        }

            .breadcrumb-news a:hover {
                color: #7dd3fc;
                text-decoration: underline;
            }

    .news-card,
    .comment-area {
        background: #131b2e;
        border: 1px solid #23314d;
        border-radius: 16px;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.35);
        transition: box-shadow .3s ease;
        animation: fadeUp .7s ease both;
    }

    .news-card {
        padding: 40px 46px;
    }

    .news-category {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: rgba(56, 189, 248, 0.15);
        border: 1px solid rgba(56, 189, 248, 0.3);
        color: #38bdf8;
        padding: 6px 14px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 800;
        margin-bottom: 18px;
        letter-spacing: .4px;
    }

    .news-title {
        font-size: 34px;
        line-height: 1.38;
        font-weight: 800;
        letter-spacing: -.5px;
        color: #f8fafc;
        margin-bottom: 20px;
    }

    .news-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        color: #94a3b8;
        font-size: 13px;
        padding-bottom: 22px;
        border-bottom: 1px solid #23314d;
        margin-bottom: 26px;
    }

        .news-meta i {
            color: #38bdf8;
            margin-right: 6px;
        }

    .news-cover-wrapper {
        position: relative;
        overflow: hidden;
        border-radius: 14px;
        border: 1px solid #2a3a5c;
        margin-bottom: 28px;
    }

    .news-cover {
        display: block;
        width: 100%;
        max-height: 500px;
        object-fit: cover;
        transition: transform .6s ease, filter .6s ease;
    }

    .news-cover-wrapper:hover .news-cover {
        transform: scale(1.03);
        filter: brightness(1.05);
    }

    .news-summary {
        padding: 20px 23px;
        border-left: 4px solid #38bdf8;
        border-radius: 10px;
        background: #1a243d;
        color: #e2e8f0;
        font-size: 16.5px;
        font-weight: 600;
        line-height: 1.85;
        margin-bottom: 32px;
    }
    .news-content {
        color: #cbd5e1;
        font-size: 16px;
        line-height: 1.95;
        overflow-wrap: anywhere;
    }

        .news-content p {
            margin-bottom: 20px;
        }

        .news-content h1,
        .news-content h2,
        .news-content h3,
        .news-content h4 {
            color: #f8fafc;
            font-weight: 750;
            line-height: 1.5;
            margin-top: 30px;
            margin-bottom: 16px;
        }

        .news-content img {
            display: block;
            max-width: 100%;
            height: auto;
            margin: 24px auto;
            border-radius: 12px;
            border: 1px solid #2a3a5c;
            box-shadow: 0 8px 22px rgba(0, 0, 0, 0.35);
        }

        .news-content blockquote {
            border-left: 4px solid #38bdf8;
            background: #1a243d;
            border-radius: 8px;
            padding: 17px 22px;
            color: #94a3b8;
            margin: 22px 0;
        }

        .news-content ul,
        .news-content ol {
            padding-left: 28px;
            margin-bottom: 20px;
        }

        .news-content li {
            margin-bottom: 8px;
        }

        .news-content a {
            color: #38bdf8;
            text-decoration: none;
        }

            .news-content a:hover {
                text-decoration: underline;
            }

        .news-content pre {
            padding: 18px;
            border-radius: 10px;
            background: #0f172a;
            border: 1px solid #23314d;
            color: #e2e8f0;
            overflow-x: auto;
        }

        .news-content table {
            width: 100%;
            border-collapse: collapse;
            margin: 22px 0;
        }

        .news-content th,
        .news-content td {
            border: 1px solid #2a3a5c;
            padding: 10px 12px;
        }

        .news-content th {
            background: #1a243d;
            color: #f8fafc;
        }

    .news-divider {
        height: 1px;
        background: #23314d;
        margin: 34px 0 24px;
    }

    .btn-back-home {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #1a243d;
        border: 1px solid #2a3a5c;
        color: #38bdf8;
        padding: 8px 16px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .btn-back-home:hover {
            background: rgba(56, 189, 248, 0.15);
            border-color: #38bdf8;
            color: #ffffff;
        }
    .comment-area {
        margin-top: 26px;
        padding: 34px 42px;
        animation-delay: .15s;
    }

    .comment-heading {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 23px;
        color: #f8fafc;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .comment-count {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        min-width: 28px;
        height: 28px;
        padding: 0 9px;
        border-radius: 30px;
        background: rgba(56, 189, 248, 0.15);
        border: 1px solid rgba(56, 189, 248, 0.3);
        color: #38bdf8;
        font-size: 13px;
    }

    .comment-description {
        color: #94a3b8;
        font-size: 13.5px;
        margin-bottom: 22px;
    }

    .comment-form textarea {
        display: block;
        width: 100%;
        min-height: 120px;
        resize: vertical;
        border: 1px solid #2a3a5c;
        border-radius: 12px;
        padding: 15px 18px;
        font-size: 14.5px;
        color: #f1f5f9;
        outline: none;
        background: #1a243d;
        transition: .25s;
    }

        .comment-form textarea:focus {
            background: #1e2a47;
            border-color: #38bdf8;
            box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15);
        }

        .comment-form textarea::placeholder {
            color: #64748b;
        }

    .comment-submit {
        margin-top: 14px;
        border: 1px solid rgba(56, 189, 248, 0.4);
        border-radius: 10px;
        padding: 11px 22px;
        color: #ffffff;
        font-size: 14px;
        font-weight: 600;
        background: linear-gradient(135deg, #0284c7, #2563eb);
        box-shadow: 0 4px 15px rgba(2, 132, 199, 0.3);
        transition: all .25s ease;
    }

        .comment-submit:hover {
            transform: translateY(-2px);
            opacity: 0.92;
        }

        .comment-submit:active {
            transform: scale(.98);
        }

    .comment-list {
        margin-top: 28px;
    }

    .comment-item {
        display: flex;
        align-items: flex-start;
        gap: 15px;
        padding: 20px 14px;
        border-bottom: 1px solid #23314d;
        border-radius: 10px;
        animation: fadeUp .5s ease both;
        transition: background .25s ease, transform .25s ease;
    }

        .comment-item:last-child {
            border-bottom: none;
        }

        .comment-item:hover {
            background: rgba(56, 189, 248, 0.05);
            transform: translateX(4px);
        }

    .comment-avatar {
        width: 44px;
        height: 44px;
        min-width: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: rgba(56, 189, 248, 0.15);
        border: 1px solid rgba(56, 189, 248, 0.3);
        color: #38bdf8;
        font-size: 16px;
        transition: transform .3s;
    }

    .comment-item:hover .comment-avatar {
        transform: rotate(-8deg) scale(1.08);
    }

    .comment-user {
        color: #f8fafc;
        font-weight: 700;
        font-size: 14px;
        margin-bottom: 4px;
    }

    .comment-time {
        color: #64748b;
        font-size: 12px;
        margin-bottom: 8px;
    }

    .comment-text {
        color: #cbd5e1;
        font-size: 14px;
        line-height: 1.75;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    .empty-comment {
        text-align: center;
        padding: 40px 10px;
        color: #64748b;
    }

        .empty-comment i {
            font-size: 40px;
            margin-bottom: 14px;
            color: #475569;
        }

        .empty-comment p {
            margin: 4px 0;
            font-size: 14px;
        }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(22px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes floatAd {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-8px);
        }
    }

    /* =========================
               6. RESPONSIVE
            ========================= */

    @@media (max-width: 1250px) {
        .news-page-layout {
            grid-template-columns: minmax(0, 950px);
        }

        .side-ad {
            display: none;
        }
    }

    @@media (max-width: 768px) {
        .news-page {
            margin: 20px auto 35px;
            padding: 0 12px;
        }

        .news-card {
            padding: 25px 18px;
        }

        .news-title {
            font-size: 26px;
        }

        .news-meta {
            gap: 12px;
        }

        .news-summary {
            font-size: 15px;
            padding: 15px;
        }

        .news-content {
            font-size: 15px;
        }

        .comment-area {
            padding: 24px 17px;
        }

        .comment-heading {
            font-size: 21px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
            animation-duration: .01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: .01ms !important;
            scroll-behavior: auto !important;
        }
    }
</style>

<div class="news-page">

    <div class="news-page-layout">
        <aside class="side-ad side-ad-left">

            <span class="ad-label">QUẢNG CÁO</span>

            <div class="ad-visual ad-blue">
                <i class="fa-solid fa-laptop-code"></i>
            </div>

            <h3 class="ad-title">
                Công nghệ cho tương lai
            </h3>

            <p class="ad-description">
                Khám phá những xu hướng công nghệ, kiến thức lập trình và giải pháp số mới nhất.
            </p>

            <ul class="ad-list">
                <li>
                    <i class="fa-solid fa-check-circle"></i>
                    Kiến thức công nghệ
                </li>
                <li>
                    <i class="fa-solid fa-check-circle"></i>
                    Lập trình và phát triển
                </li>
                <li>
                    <i class="fa-solid fa-check-circle"></i>
                    Xu hướng AI
                </li>
            </ul>

            <a href="https://www.theverge.com" class="ad-button">
                KHÁM PHÁ NGAY
                <i class="fa-solid fa-arrow-right ms-1"></i>
            </a>

            <div class="ad-decoration"></div>

        </aside>
        <main class="news-main">

            @if (baiviet != null)
            {
                <div class="breadcrumb-news">
                    <a asp-controller="Trangchu" asp-action="Trangdau">
                        <i class="fa-solid fa-house me-1"></i>
                        Trang chủ
                    </a>

                    <span class="mx-2">/</span>

                    <span>Chi tiết bài viết</span>
                </div>
                <article class="news-card">

                    <div class="news-category">
                        <i class="fa-solid fa-newspaper"></i>
                        TIN TỨC
                    </div>

                    <h1 class="news-title">
                        @baiviet.TieuDe
                    </h1>

                    <div class="news-meta">

                        <span>
                            <i class="fa-regular fa-calendar"></i>
                            @baiviet.NgayTao.ToString("dd/MM/yyyy HH:mm")
                        </span>

                        <span>
                            <i class="fa-regular fa-user"></i>
                            Tin tức tổng hợp
                        </span>

                        <span>
                            <i class="fa-regular fa-comments"></i>
                            @(danhsachbinhluan?.Count ?? 0) bình luận
                        </span>

                    </div>

                    @if (!string.IsNullOrEmpty(baiviet.AnhDaiDien))
                    {
                        <div class="news-cover-wrapper">
                            <img class="news-cover"
                                 src="~/images/@baiviet.AnhDaiDien"
                                 alt="@baiviet.TieuDe" />
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(baiviet.TomTat))
                    {
                        <div class="news-summary">
                            @baiviet.TomTat
                        </div>
                    }
                    <div class="news-content">
                        @Html.Raw(baiviet.NoiDung)
                    </div>

                    <div class="news-divider"></div>

                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <span style="font-size:13px; color:#64748b;">
                            <i class="fa-solid fa-book-open me-1" style="color: #38bdf8;"></i>
                            Cảm ơn bạn đã đọc bài viết.
                        </span>

                        <a asp-controller="Trangchu"
                           asp-action="Trangdau"
                           class="btn-back-home">
                            <i class="fa-solid fa-arrow-left"></i>
                            Quay lại trang chủ
                        </a>
                    </div>

                </article>
                <section class="comment-area">

                    <h2 class="comment-heading">
                        <i class="fa-regular fa-comments"
                           style="color:#38bdf8;"></i>

                        Thảo luận

                        <span class="comment-count">
                            @(danhsachbinhluan?.Count ?? 0)
                        </span>
                    </h2>

                    <p class="comment-description">
                        Hãy chia sẻ ý kiến và góc nhìn của bạn về bài viết này.
                    </p>
                    <form asp-controller="Giaodienbaiviet"
                          asp-action="ChiTiet"
                          method="get"
                          class="comment-form">

                        <input type="hidden"
                               name="id"
                               value="@baiviet.MaBaiViet" />

                        <textarea name="binhluanthem"
                                  placeholder="Bạn nghĩ gì về bài viết này? Hãy viết bình luận tại đây..."
                                  maxlength="2000"
                                  required></textarea>

                        <div class="text-end">

                            <button type="submit" class="comment-submit">
                                <i class="fa-regular fa-paper-plane me-2"></i>
                                Gửi bình luận
                            </button>

                        </div>
                    </form>
                    <div class="comment-list">

                        @if (danhsachbinhluan != null && danhsachbinhluan.Count > 0)
                        {
                            foreach (var bl in danhsachbinhluan.OrderByDescending(x => x.NgayBinhLuan))
                            {
                                <div class="comment-item">

                                    <div class="comment-avatar">
                                        <i class="fa-solid fa-user"></i>
                                    </div>

                                    <div class="flex-grow-1">

                                        <div class="comment-user">
                                            Độc giả #@bl.MaDocGia
                                        </div>

                                        <div class="comment-time">
                                            <i class="fa-regular fa-clock me-1"></i>
                                            @bl.NgayBinhLuan.ToString("dd/MM/yyyy HH:mm")
                                        </div>

                                        <div class="comment-text">
                                            @bl.NoiDung
                                        </div>

                                    </div>

                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-comment">

                                <i class="fa-regular fa-comments"></i>

                                <p style="color: #cbd5e1;"><strong>Chưa có bình luận nào!</strong></p>

                                <p>Hãy là người đầu tiên chia sẻ ý kiến của bạn.</p>

                            </div>
                        }

                    </div>

                </section>
            }
            else
            {
                <div class="news-card text-center py-5">
                    <i class="fa-solid fa-circle-exclamation fa-3x mb-3" style="color: #475569;"></i>
                    <h3 style="color: #f8fafc;">Không tìm thấy bài viết</h3>
                    <a asp-controller="Trangchu"
                       asp-action="Trangdau"
                       class="btn-back-home mt-3">
                        <i class="fa-solid fa-arrow-left"></i>
                        Quay lại trang chủ
                    </a>
                </div>
            }

        </main>
        <aside class="side-ad side-ad-right">

            <span class="ad-label">QUẢNG CÁO</span>

            <div class="ad-visual ad-purple">
                <i class="fa-solid fa-graduation-cap"></i>
            </div>

            <h3 class="ad-title">
                Học tập và phát triển
            </h3>

            <p class="ad-description">
                Cập nhật kiến thức, nâng cao kỹ năng và khám phá những cơ hội học tập mới.
            </p>

            <ul class="ad-list">
                <li>
                    <i class="fa-solid fa-check-circle"></i>
                    Tài liệu học tập
                </li>
                <li>
                    <i class="fa-solid fa-check-circle"></i>
                    Kỹ năng chuyên môn
                </li>
                <li>
                    <i class="fa-solid fa-check-circle"></i>
                    Kiến thức mới
                </li>
            </ul>

            <a href="https://devmaster.edu.vn" class="ad-button ad-button-purple">
                TÌM HIỂU THÊM
                <i class="fa-solid fa-arrow-right ms-1"></i>
            </a>

            <div class="ad-decoration"></div>

        </aside>

    </div>
</div>
@if (ViewBag.ThongBao != null)
{
    <script>
        alert(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                                                                    (string)ViewBag.ThongBao)));
    </script>
}