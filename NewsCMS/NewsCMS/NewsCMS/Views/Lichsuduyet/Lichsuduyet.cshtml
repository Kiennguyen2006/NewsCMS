@using NewsCMS.Models
@{
    Layout = "~/Views/Shared/_AdminLTELayout.cshtml";
}
@{
    ViewData["Title"] = "Lịch sử duyệt bài viết";

    var bang = ViewBag.bang as List<LichSuDuyetModel>
               ?? new List<LichSuDuyetModel>();

    int? matk = ViewBag.matk;
}

<style>
    .history-container {
        max-width: 1300px;
        margin: 20px auto;
        padding: 15px;
    }

    .history-header {
        background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
        border: 1px solid #334155;
        color: #f8fafc;
        padding: 30px 34px;
        border-radius: 18px;
        margin-bottom: 24px;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.3);
        position: relative;
        overflow: hidden;
    }

        .history-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
            background: linear-gradient(to bottom, #38bdf8, #2563eb);
        }

        .history-header h2 {
            font-weight: 800;
            font-size: 24px;
            margin-bottom: 8px;
            color: #ffffff;
        }

            .history-header h2 i {
                color: #38bdf8;
                margin-right: 8px;
            }

        .history-header p {
            color: #94a3b8;
            font-size: 14px;
        }

    .search-box {
        background: #131b2e;
        border: 1px solid #23314d;
        padding: 22px 24px;
        border-radius: 16px;
        margin-bottom: 24px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    }

        .search-box .form-label {
            color: #cbd5e1;
            font-size: 14px;
            margin-bottom: 10px;
        }

    .slate-input-group .form-control {
        background-color: #1a243d !important;
        border: 1px solid #2a3a5c !important;
        color: #f1f5f9 !important;
        border-radius: 10px 0 0 10px !important;
        padding: 11px 16px;
        font-size: 14px;
    }

        .slate-input-group .form-control:focus {
            border-color: #38bdf8 !important;
            box-shadow: none !important;
        }

        .slate-input-group .form-control::placeholder {
            color: #64748b;
        }

    .btn-slate-search {
        background: linear-gradient(135deg, #0284c7, #2563eb);
        border: 1px solid rgba(56, 189, 248, 0.4);
        color: #ffffff;
        font-weight: 600;
        padding: 0 22px;
        transition: all 0.2s ease;
    }

        .btn-slate-search:hover {
            opacity: 0.92;
            color: #ffffff;
        }

    .btn-slate-reset {
        background: #1e293b;
        border: 1px solid #334155;
        color: #cbd5e1;
        font-weight: 600;
        padding: 0 20px;
        border-radius: 0 10px 10px 0 !important;
        display: inline-flex;
        align-items: center;
        transition: all 0.2s ease;
    }

        .btn-slate-reset:hover {
            background: #334155;
            color: #ffffff;
        }

    .table-box {
        background: #131b2e;
        border: 1px solid #23314d;
        border-radius: 16px;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.3);
        overflow: hidden;
    }

    .table-box-header {
        background: rgba(26, 36, 61, 0.6);
        border-bottom: 1px solid #23314d;
        padding: 18px 24px;
    }

        .table-box-header h5 {
            color: #f8fafc;
            font-size: 16px;
        }

            .table-box-header h5 i {
                color: #38bdf8;
                margin-right: 8px;
            }

    .slate-badge-count {
        background: rgba(56, 189, 248, 0.15);
        color: #38bdf8;
        border: 1px solid rgba(56, 189, 248, 0.3);
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .slate-table {
        color: #e2e8f0;
        margin-bottom: 0;
    }

        .slate-table thead th {
            background: #1a243d;
            color: #94a3b8;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            border-bottom: 1px solid #23314d;
            border-top: none;
            white-space: nowrap;
            padding: 15px 18px;
        }

        .slate-table tbody td {
            background: transparent;
            border-bottom: 1px solid #1e293b;
            padding: 15px 18px;
            vertical-align: middle;
            color: #cbd5e1;
            font-size: 14px;
        }

        .slate-table tbody tr {
            transition: background-color 0.2s ease;
        }

            .slate-table tbody tr:hover td {
                background-color: rgba(56, 189, 248, 0.06);
            }

            .slate-table tbody tr:last-child td {
                border-bottom: none;
            }

    .slate-id-pill {
        background: #1e293b;
        color: #cbd5e1;
        border: 1px solid #334155;
        padding: 5px 11px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .action-badge {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    .action-approve {
        background: rgba(16, 185, 129, 0.15);
        color: #34d399;
        border: 1px solid rgba(16, 185, 129, 0.3);
    }

    .action-reject {
        background: rgba(239, 68, 68, 0.15);
        color: #f87171;
        border: 1px solid rgba(239, 68, 68, 0.3);
    }

    .action-edit {
        background: rgba(245, 158, 11, 0.15);
        color: #fbbf24;
        border: 1px solid rgba(245, 158, 11, 0.3);
    }

    .action-default {
        background: rgba(56, 189, 248, 0.15);
        color: #38bdf8;
        border: 1px solid rgba(56, 189, 248, 0.3);
    }

    .note-cell {
        min-width: 200px;
        max-width: 340px;
        overflow-wrap: anywhere;
        color: #e2e8f0;
    }

    .empty-data {
        padding: 50px 15px;
        text-align: center;
        color: #64748b;
    }

        .empty-data h5 {
            color: #cbd5e1;
            font-weight: 700;
        }

    .history-footer {
        margin-top: 24px;
    }

    .btn-slate-back {
        background: #1a243d;
        border: 1px solid #2a3a5c;
        color: #38bdf8;
        border-radius: 10px;
        padding: 10px 20px;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.2s ease;
    }

        .btn-slate-back:hover {
            background: rgba(56, 189, 248, 0.15);
            border-color: #38bdf8;
            color: #ffffff;
            transform: translateY(-2px);
        }

    @@media (max-width: 768px) {
        .history-container {
            padding: 12px;
            margin: 15px auto;
        }

        .history-header {
            padding: 20px;
        }
    }
</style>

<div class="history-container">

    <div class="history-header">
        <h2>
            <i class="bi bi-clock-history"></i>
            Lịch sử duyệt bài viết
        </h2>

        <p class="mb-0">
            Theo dõi các hoạt động duyệt, chỉnh sửa và xử lý bài viết trong hệ thống.
        </p>
    </div>

    <div class="search-box">
        <form asp-controller="Lichsuduyet"
              asp-action="Lichsuduyet"
              method="get">

            <label class="form-label fw-bold">
                Tìm kiếm lịch sử
            </label>

            <div class="input-group slate-input-group">
                <input type="number"
                       name="matk"
                       class="form-control"
                       placeholder="Nhập mã lịch sử, mã bài viết hoặc mã người duyệt..."
                       value="@(matk?.ToString() ?? "")" />

                <button type="submit" class="btn btn-slate-search">
                    <i class="bi bi-search me-1"></i> Tìm kiếm
                </button>

                <a asp-controller="Lichsuduyet"
                   asp-action="Lichsuduyet"
                   class="btn btn-slate-reset">
                    Làm mới
                </a>
            </div>
        </form>
    </div>

    <div class="table-box">

        <div class="table-box-header d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-list-ul"></i>
                Danh sách lịch sử
            </h5>

            <span class="slate-badge-count">
                @bang.Count bản ghi
            </span>
        </div>

        <div class="table-responsive">
            <table class="table slate-table align-middle mb-0">

                <thead>
                    <tr>
                        <th>Mã lịch sử</th>
                        <th>Mã bài viết</th>
                        <th>Người duyệt</th>
                        <th>Hành động</th>
                        <th>Ghi chú</th>
                        <th>Thời gian</th>
                    </tr>
                </thead>

                <tbody>

                    @if (bang.Any())
                    {
                        foreach (var item in bang)
                        {
                            var hanhDong = item.HanhDong ?? "";

                            var badgeClass =
                                hanhDong.Contains("Duyệt",
                                    StringComparison.OrdinalIgnoreCase)
                                ? "action-approve"
                                : hanhDong.Contains("Từ chối",
                                    StringComparison.OrdinalIgnoreCase)
                                ? "action-reject"
                                : hanhDong.Contains("Sửa",
                                    StringComparison.OrdinalIgnoreCase)
                                ? "action-edit"
                                : "action-default";

                            <tr>
                                <td class="fw-bold" style="color: #38bdf8;">
                                    #@item.MaLichSu
                                </td>

                                <td>
                                    <span class="slate-id-pill">
                                        #@item.MaBaiViet
                                    </span>
                                </td>

                                <td>
                                    <span class="slate-id-pill">
                                        #@item.MaNguoiDuyet
                                    </span>
                                </td>

                                <td>
                                    <span class="action-badge @badgeClass">
                                        @item.HanhDong
                                    </span>
                                </td>

                                <td class="note-cell">
                                    @if (!string.IsNullOrWhiteSpace(item.GhiChu))
                                    {
                                        @item.GhiChu
                                    }
                                    else
                                    {
                                        <span class="fst-italic" style="color: #64748b;">
                                            Không có ghi chú
                                        </span>
                                    }
                                </td>

                                <td style="white-space:nowrap; color: #94a3b8;">
                                    @item.ThoiGian.ToString("dd/MM/yyyy HH:mm:ss")
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">
                                <div class="empty-data">
                                    <i class="bi bi-inbox"
                                       style="font-size:45px; color: #475569;"></i>

                                    <h5 class="mt-3">
                                        Không tìm thấy lịch sử
                                    </h5>

                                    <p class="mb-0">
                                        Chưa có dữ liệu hoặc không có kết quả phù hợp.
                                    </p>
                                </div>
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>

    <div class="history-footer">
        <a asp-controller="Trangchu"
           asp-action="Trangdau"
           class="btn btn-slate-back">
            <i class="bi bi-arrow-left me-1"></i>
            Quay lại quản lý bài viết
        </a>
    </div>

</div>