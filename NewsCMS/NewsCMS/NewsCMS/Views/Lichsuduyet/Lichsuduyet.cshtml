@using NewsCMS.Models
@{
    Layout = "~/Views/Shared/_AdminLTELayout.cshtml";
}
@{
    ViewData["Title"] = "Lịch sử duyệt bài viết";

    var bang = ViewBag.bang as List<LichSuDuyetModel>
               ?? new List<LichSuDuyetModel>();

    int? matk = ViewBag.matk;
}

<style>
    body {
        background: #f4f6fb;
    }

    .history-container {
        max-width: 1250px;
        margin: 35px auto;
        padding: 25px;
    }

    .history-header {
        background: linear-gradient(135deg, #1e3a8a, #2563eb);
        color: white;
        padding: 30px;
        border-radius: 16px;
        margin-bottom: 25px;
        box-shadow: 0 5px 18px rgba(0,0,0,0.12);
    }

        .history-header h2 {
            font-weight: 700;
            margin-bottom: 8px;
        }

    .search-box {
        background: white;
        padding: 20px;
        border-radius: 12px;
        margin-bottom: 22px;
        box-shadow: 0 3px 12px rgba(0,0,0,0.05);
    }

    .table-box {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 3px 12px rgba(0,0,0,0.05);
        overflow-x: auto;
    }

    .table thead th {
        background: #eff4ff;
        color: #1e3a8a;
        white-space: nowrap;
        padding: 15px;
    }

    .table tbody td {
        padding: 15px;
        vertical-align: middle;
    }

    .table tbody tr:hover {
        background: #f8faff;
    }

    .action-badge {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
    }

    .action-approve {
        background: #dcfce7;
        color: #166534;
    }

    .action-reject {
        background: #fee2e2;
        color: #991b1b;
    }

    .action-edit {
        background: #fef3c7;
        color: #92400e;
    }

    .action-default {
        background: #e0e7ff;
        color: #3730a3;
    }

    .note-cell {
        min-width: 200px;
        max-width: 320px;
        overflow-wrap: anywhere;
    }

    .empty-data {
        padding: 45px 15px;
        text-align: center;
        color: #64748b;
    }

    .history-footer {
        margin-top: 20px;
    }

    @@media (max-width: 768px) {
        .history-container {
            padding: 12px;
            margin: 15px auto;
        }

        .history-header {
            padding: 20px;
        }
    }
</style>

<div class="history-container">

    <!-- Tiêu đề -->
    <div class="history-header">
        <h2>
            <i class="bi bi-clock-history"></i>
            Lịch sử duyệt bài viết
        </h2>

        <p class="mb-0">
            Theo dõi các hoạt động duyệt, chỉnh sửa và xử lý bài viết trong hệ thống.
        </p>
    </div>

    <!-- Tìm kiếm -->
    <div class="search-box">
        <form asp-controller="Lichsuduyet"
              asp-action="Lichsuduyet"
              method="get">

            <label class="form-label fw-bold">
                Tìm kiếm lịch sử
            </label>

            <div class="input-group">
                <input type="number"
                       name="matk"
                       class="form-control"
                       placeholder="Nhập mã lịch sử, mã bài viết hoặc mã người duyệt..."
                       value="@(matk?.ToString() ?? "")" />

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i> Tìm kiếm
                </button>

                <a asp-controller="Lichsuduyet"
                   asp-action="Lichsuduyet"
                   class="btn btn-outline-secondary">
                    Làm mới
                </a>
            </div>
        </form>
    </div>

    <!-- Bảng lịch sử -->
    <div class="table-box">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-list-ul"></i>
                Danh sách lịch sử
            </h5>

            <span class="badge bg-primary">
                @bang.Count bản ghi
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle mb-0">

                <thead>
                    <tr>
                        <th>Mã lịch sử</th>
                        <th>Mã bài viết</th>
                        <th>Người duyệt</th>
                        <th>Hành động</th>
                        <th>Ghi chú</th>
                        <th>Thời gian</th>
                    </tr>
                </thead>

                <tbody>

                    @if (bang.Any())
                    {
                        foreach (var item in bang)
                        {
                            var hanhDong = item.HanhDong ?? "";

                            var badgeClass =
                                hanhDong.Contains("Duyệt",
                                    StringComparison.OrdinalIgnoreCase)
                                ? "action-approve"
                                : hanhDong.Contains("Từ chối",
                                    StringComparison.OrdinalIgnoreCase)
                                ? "action-reject"
                                : hanhDong.Contains("Sửa",
                                    StringComparison.OrdinalIgnoreCase)
                                ? "action-edit"
                                : "action-default";

                            <tr>
                                <td class="fw-bold text-primary">
                                    #@item.MaLichSu
                                </td>

                                <td>
                                    <span class="badge bg-light text-dark border">
                                        #@item.MaBaiViet
                                    </span>
                                </td>

                                <td>
                                    <span class="badge bg-light text-dark border">
                                        #@item.MaNguoiDuyet
                                    </span>
                                </td>

                                <td>
                                    <span class="action-badge @badgeClass">
                                        @item.HanhDong
                                    </span>
                                </td>

                                <td class="note-cell">
                                    @if (!string.IsNullOrWhiteSpace(item.GhiChu))
                                    {
                                        @item.GhiChu
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">
                                            Không có ghi chú
                                        </span>
                                    }
                                </td>

                                <td style="white-space:nowrap">
                                    @item.ThoiGian.ToString("dd/MM/yyyy HH:mm:ss")
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">
                                <div class="empty-data">
                                    <i class="bi bi-inbox"
                                       style="font-size:45px"></i>

                                    <h5 class="mt-3">
                                        Không tìm thấy lịch sử
                                    </h5>

                                    <p class="mb-0">
                                        Chưa có dữ liệu hoặc không có kết quả phù hợp.
                                    </p>
                                </div>
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>
    <div class="history-footer">
        <a asp-controller="Trangchu"
           asp-action="Trangdau"
           class="btn btn-outline-primary">
            <i class="bi bi-arrow-left"></i>
            Quay lại quản lý bài viết
        </a>
    </div>

</div>
