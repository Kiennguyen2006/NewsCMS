@{
    Layout = "~/Views/Shared/_AdminLTELayout.cshtml";
}
@{
    ViewData["Title"] = "Xóa nhân viên";
    var nv = ViewBag.bang;
}

<style>
    .delete-employee-page {
        max-width: 850px;
        margin: 25px auto;
        padding: 0 15px;
    }

    .delete-card {
        background: #131b2e;
        border: 1px solid #23314d;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.35);
    }

    .delete-header {
        background: linear-gradient(135deg, rgba(220, 38, 38, 0.25), rgba(153, 27, 27, 0.35));
        border-bottom: 1px solid rgba(239, 68, 68, 0.3);
        text-align: center;
        padding: 32px 25px;
    }

    .delete-icon {
        width: 68px;
        height: 68px;
        background: rgba(239, 68, 68, 0.15);
        border: 1px solid rgba(239, 68, 68, 0.35);
        color: #f87171;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 15px;
        font-size: 28px;
    }

    .delete-header h3 {
        color: #f87171;
        font-weight: 800;
        font-size: 22px;
        margin-bottom: 8px;
    }

    .delete-header p {
        margin: 0;
        color: #94a3b8;
        font-size: 14px;
    }

    .delete-body {
        padding: 30px;
    }

    .delete-warning {
        background: rgba(245, 158, 11, 0.12);
        border: 1px solid rgba(245, 158, 11, 0.3);
        border-radius: 12px;
        padding: 16px 18px;
        color: #fbbf24;
        font-size: 14px;
        line-height: 1.6;
        margin-bottom: 25px;
    }

        .delete-warning strong {
            display: block;
            margin-bottom: 5px;
        }

    .employee-info-title {
        font-weight: 700;
        color: #38bdf8;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        margin-bottom: 15px;
    }

    .employee-info-table {
        border: 1px solid #23314d;
        border-radius: 12px;
        overflow: hidden;
    }

        .employee-info-table table {
            margin-bottom: 0;
            width: 100%;
            border-collapse: collapse;
        }

        .employee-info-table tr {
            border-bottom: 1px solid #23314d;
        }

            .employee-info-table tr:last-child {
                border-bottom: none;
            }

        .employee-info-table th {
            width: 38%;
            background: #1a243d;
            color: #94a3b8;
            font-weight: 600;
            font-size: 14px;
            padding: 14px 16px;
        }

        .employee-info-table td {
            background: #131b2e;
            padding: 14px 16px;
            color: #f1f5f9;
            font-size: 14px;
        }

    .delete-footer {
        border-top: 1px solid #23314d;
        margin-top: 25px;
        padding-top: 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

    .btn-slate-cancel {
        background: #1e293b;
        border: 1px solid #334155;
        color: #cbd5e1;
        border-radius: 10px;
        padding: 10px 22px;
        font-weight: 600;
        font-size: 14px;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .btn-slate-cancel:hover {
            background: #334155;
            color: #ffffff;
        }

    .btn-confirm-delete {
        background: linear-gradient(135deg, #dc2626, #b91c1c);
        border: 1px solid rgba(248, 113, 113, 0.4);
        color: white;
        border-radius: 10px;
        padding: 10px 24px;
        font-weight: 600;
        font-size: 14px;
        box-shadow: 0 4px 15px rgba(220, 38, 38, 0.3);
        transition: all 0.2s ease;
    }

        .btn-confirm-delete:hover {
            background: linear-gradient(135deg, #ef4444, #dc2626);
            color: white;
            transform: translateY(-1px);
        }

    .delete-note {
        color: #64748b;
        font-size: 13px;
        margin-top: 18px;
    }
</style>

<div class="delete-employee-page">
    @if (nv != null)
    {
        <div class="delete-card">
            <div class="delete-header">
                <div class="delete-icon">
                    <i class="bi bi-person-x-fill"></i>
                </div>
                <h3>Xác nhận xóa nhân viên</h3>
                <p>Vui lòng kiểm tra thông tin trước khi thực hiện thao tác.</p>
            </div>

            <div class="delete-body">
                <div class="delete-warning">
                    <strong>
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        Cảnh báo: Thao tác này có thể ảnh hưởng đến dữ liệu liên quan.
                    </strong>
                    Theo logic xóa hiện tại trong Controller, các bài viết, bình luận
                    và lịch sử duyệt thuộc nhóm bài viết được chọn có thể bị xóa.
                    Vui lòng cân nhắc trước khi xác nhận.
                </div>

                <div class="employee-info-title">
                    <i class="bi bi-person-vcard me-2"></i>
                    Thông tin nhân viên cần xóa
                </div>

                <div class="employee-info-table">
                    <table class="table table-borderless">
                        <tr>
                            <th>Mã nhân viên</th>
                            <td><strong style="color: #38bdf8;">NV-@nv.MaNhanVien</strong></td>
                        </tr>
                        <tr>
                            <th>Mã tài khoản</th>
                            <td>@nv.MaTaiKhoan</td>
                        </tr>
                        <tr>
                            <th>Họ và tên</th>
                            <td class="fw-semibold">@nv.HoTen</td>
                        </tr>
                        <tr>
                            <th>Số điện thoại</th>
                            <td>@nv.SoDienThoai</td>
                        </tr>
                        <tr>
                            <th>Ngày vào làm</th>
                            <td>
                                @(nv.NgayVaoLam == null
                                    ? "Chưa cập nhật"
                                    : ((DateTime)nv.NgayVaoLam).ToString("dd/MM/yyyy"))
                            </td>
                        </tr>
                    </table>
                </div>

                <div class="delete-note">
                    <i class="bi bi-info-circle me-1"></i>
                    Tài khoản đăng nhập không được xóa bởi đoạn xử lý hiện tại.
                </div>

                <div class="delete-footer">
                    <a asp-controller="Nhanvien" asp-action="Nhanvien"
                       class="btn-slate-cancel">
                        <i class="bi bi-arrow-left me-1"></i> Hủy bỏ
                    </a>

                    <form asp-controller="Nhanvien" asp-action="Xoanv" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="MaNhanVien" value="@nv.MaNhanVien" />
                        <input type="hidden" name="MaTaiKhoan" value="@nv.MaTaiKhoan" />
                        <input type="hidden" name="HoTen" value="@nv.HoTen" />
                        <input type="hidden" name="SoDienThoai" value="@nv.SoDienThoai" />
                        <input type="hidden" name="NgayVaoLam"
                               value="@(nv.NgayVaoLam == null ? "" : ((DateTime)nv.NgayVaoLam).ToString("yyyy-MM-dd"))" />

                        <button type="submit" class="btn btn-confirm-delete">
                            <i class="bi bi-trash3 me-2"></i>
                            Xác nhận xóa
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert rounded-3 p-4" style="background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171;">
            Không tìm thấy nhân viên cần xóa.
        </div>
    }
</div>