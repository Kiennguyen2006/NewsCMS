@model NewsCMS.Models.NhanVienModel
@{
    Layout = "~/Views/Shared/_AdminLTELayout.cshtml";
}
@{
    ViewData["Title"] = "Thêm nhân viên";
    var bangtk = ViewBag.bangtk;
}

<style>
    .slate-form-card {
        background: #131b2e;
        border: 1px solid #23314d;
        border-radius: 16px;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.35);
        overflow: hidden;
    }

    .slate-form-header {
        background: linear-gradient(135deg, rgba(2, 132, 199, 0.25), rgba(37, 99, 235, 0.25));
        border-bottom: 1px solid rgba(56, 189, 248, 0.3);
        padding: 22px 28px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .slate-form-header h4 {
            color: #f8fafc;
            font-weight: 800;
            font-size: 20px;
            margin: 0;
        }

        .slate-form-header i {
            color: #38bdf8;
        }

    .form-label {
        color: #cbd5e1;
        font-size: 14px;
        margin-bottom: 8px;
    }

    .form-control, .form-select {
        background-color: #1a243d !important;
        border: 1px solid #2a3a5c !important;
        color: #f1f5f9 !important;
        border-radius: 10px !important;
        padding: 11px 14px !important;
        font-size: 14px;
        transition: all 0.2s ease;
    }

        .form-control:focus, .form-select:focus {
            border-color: #38bdf8 !important;
            box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15) !important;
            background-color: #1e2a47 !important;
        }

        .form-control::placeholder {
            color: #64748b;
        }

    .btn-slate-back {
        background: #1a243d;
        border: 1px solid #2a3a5c;
        color: #38bdf8;
        border-radius: 10px;
        padding: 9px 18px;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.2s ease;
    }

        .btn-slate-back:hover {
            background: rgba(56, 189, 248, 0.15);
            border-color: #38bdf8;
            color: #ffffff;
        }

    .btn-slate-secondary {
        background: #1e293b;
        border: 1px solid #334155;
        color: #cbd5e1;
        border-radius: 10px;
        padding: 10px 22px;
        font-weight: 600;
        transition: all 0.2s ease;
    }

        .btn-slate-secondary:hover {
            background: #334155;
            color: #ffffff;
        }

    .btn-slate-primary {
        background: linear-gradient(135deg, #0284c7, #2563eb);
        border: 1px solid rgba(56, 189, 248, 0.4);
        color: #ffffff;
        border-radius: 10px;
        padding: 10px 24px;
        font-weight: 600;
        box-shadow: 0 4px 15px rgba(2, 132, 199, 0.3);
        transition: all 0.2s ease;
    }

        .btn-slate-primary:hover {
            opacity: 0.92;
            color: #ffffff;
            transform: translateY(-1px);
        }

    .text-danger {
        color: #f87171 !important;
        font-size: 13px;
    }
</style>

<div class="container py-3" style="max-width: 750px;">

    <div class="mb-4">
        <a asp-controller="Nhanvien" asp-action="Nhanvien"
           class="btn btn-slate-back">
            <i class="bi bi-arrow-left me-1"></i>
            Quay lại danh sách nhân viên
        </a>
    </div>

    <div class="slate-form-card mx-auto">

        <div class="slate-form-header">
            <h4 class="mb-0">
                <i class="bi bi-person-plus-fill me-2"></i>
                Thêm nhân viên
            </h4>
        </div>

        <div class="p-4">

            @if (ViewBag.thongbao != null)
            {
                <div class="alert rounded-3 p-3 mb-4" style="background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.3); color: #fca5a5;">
                    <i class="bi bi-exclamation-circle me-1"></i> @ViewBag.thongbao
                </div>
            }

            <form asp-controller="Nhanvien" asp-action="Themnv" method="post">

                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label fw-semibold">Tài khoản</label>

                    <select asp-for="MaTaiKhoan" class="form-select">
                        <option value="">-- Chọn tài khoản --</option>

                        @if (bangtk != null)
                        {
                            foreach (var tk in bangtk)
                            {
                                <option value="@tk.MaTaiKhoan">
                                    TK-@tk.MaTaiKhoan
                                </option>
                            }
                        }
                    </select>

                    <span asp-validation-for="MaTaiKhoan"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="HoTen" class="form-label fw-semibold">
                        Họ tên nhân viên
                    </label>

                    <input asp-for="HoTen" class="form-control"
                           placeholder="Nhập họ tên nhân viên" />

                    <span asp-validation-for="HoTen"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SoDienThoai" class="form-label fw-semibold">
                        Số điện thoại
                    </label>

                    <input asp-for="SoDienThoai" class="form-control"
                           placeholder="Nhập số điện thoại" />

                    <span asp-validation-for="SoDienThoai"
                          class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="NgayVaoLam" class="form-label fw-semibold">
                        Ngày vào làm
                    </label>

                    <input asp-for="NgayVaoLam" type="date"
                           class="form-control" />

                    <span asp-validation-for="NgayVaoLam"
                          class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top" style="border-color: #23314d !important;">
                    <a asp-controller="Nhanvien" asp-action="Nhanvien"
                       class="btn btn-slate-secondary">
                        Hủy
                    </a>

                    <button type="submit" class="btn btn-slate-primary">
                        <i class="bi bi-floppy me-1"></i>
                        Thêm nhân viên
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}