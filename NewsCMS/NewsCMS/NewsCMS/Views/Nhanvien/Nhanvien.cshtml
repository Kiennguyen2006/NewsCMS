@{
    ViewData["Title"] = "Quản lý nhân viên";
    var bang = ViewBag.bang as IEnumerable<NewsCMS.Models.NhanVienModel>;
}
@{
    Layout = "~/Views/Shared/_AdminLTELayout.cshtml";
}

<style>
    .admin-wrapper {
        min-height: 85vh;
        padding: 15px;
    }

    .admin-topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 15px;
    }

    .btn-custom-back {
        background: #1a243d;
        color: #38bdf8;
        border: 1px solid #2a3a5c;
        padding: 10px 18px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.2s ease;
        text-decoration: none;
    }

        .btn-custom-back:hover {
            background: rgba(56, 189, 248, 0.15);
            border-color: #38bdf8;
            color: #ffffff;
            transform: translateY(-2px);
        }

    .btn-custom-add {
        background: linear-gradient(135deg, #0284c7, #2563eb);
        border: 1px solid rgba(56, 189, 248, 0.4);
        color: white;
        padding: 10px 20px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 14px;
        box-shadow: 0 4px 15px rgba(2, 132, 199, 0.25);
        transition: all 0.2s ease;
        text-decoration: none;
    }

        .btn-custom-add:hover {
            color: white;
            opacity: 0.92;
            transform: translateY(-2px);
        }

    .admin-card {
        background: #131b2e;
        border: 1px solid #23314d;
        border-radius: 16px;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.3);
        overflow: hidden;
    }

    .admin-card-header {
        padding: 22px 28px;
        border-bottom: 1px solid #23314d;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
        background: rgba(26, 36, 61, 0.6);
    }

    .admin-title h4 {
        font-weight: 800;
        color: #f8fafc;
        margin: 0 0 4px 0;
        font-size: 20px;
    }

    .admin-title p {
        color: #94a3b8;
        margin: 0;
        font-size: 14px;
    }

    .search-group {
        display: flex;
        max-width: 380px;
        width: 100%;
        background: #1a243d;
        border: 1px solid #2a3a5c;
        border-radius: 10px;
        overflow: hidden;
        transition: all 0.2s;
    }

        .search-group:focus-within {
            border-color: #38bdf8;
            box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15);
        }

        .search-group input {
            border: none;
            background: transparent;
            color: #f1f5f9;
            padding: 10px 14px;
            font-size: 14px;
            box-shadow: none !important;
        }

            .search-group input::placeholder {
                color: #64748b;
            }

        .search-group button {
            background: linear-gradient(135deg, #0284c7, #2563eb);
            color: white;
            border: none;
            padding: 0 18px;
            font-weight: 600;
        }

        .search-group .btn-refresh {
            background: #26354d;
            color: #cbd5e1;
            border: none;
            padding: 0 14px;
            display: flex;
            align-items: center;
            text-decoration: none;
        }

            .search-group .btn-refresh:hover {
                background: #334155;
                color: #ffffff;
            }

    .table-custom {
        margin-bottom: 0;
        color: #e2e8f0;
    }

        .table-custom th {
            background: #1a243d;
            color: #94a3b8;
            font-weight: 700;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            padding: 15px 20px;
            border-bottom: 1px solid #23314d;
            border-top: none;
        }

        .table-custom td {
            padding: 15px 20px;
            vertical-align: middle;
            background: transparent;
            color: #cbd5e1;
            font-size: 14px;
            border-bottom: 1px solid #1e293b;
        }

        .table-custom tbody tr {
            transition: background-color 0.15s ease;
        }

            .table-custom tbody tr:hover td {
                background-color: rgba(56, 189, 248, 0.06);
            }

            .table-custom tbody tr:last-child td {
                border-bottom: none;
            }

    .badge-code {
        font-family: monospace;
        font-weight: 700;
        color: #38bdf8;
        background: rgba(56, 189, 248, 0.15);
        padding: 5px 10px;
        border-radius: 8px;
        border: 1px solid rgba(56, 189, 248, 0.3);
    }

    .badge-account {
        background: #1e293b;
        color: #cbd5e1;
        padding: 6px 12px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 12px;
        border: 1px solid #334155;
    }

    .staff-avatar {
        width: 36px;
        height: 36px;
        background: linear-gradient(135deg, #0284c7, #2563eb);
        color: white;
        font-weight: 700;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-right: 12px;
        font-size: 14px;
        box-shadow: 0 3px 10px rgba(2, 132, 199, 0.3);
    }

    .btn-action {
        width: 34px;
        height: 34px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        transition: all 0.2s;
        margin: 0 3px;
    }

        .btn-action.btn-edit {
            background: rgba(245, 158, 11, 0.15);
            color: #fbbf24;
            border: 1px solid rgba(245, 158, 11, 0.3);
        }

            .btn-action.btn-edit:hover {
                background: #f59e0b;
                color: #0f172a;
                transform: translateY(-2px);
            }

        .btn-action.btn-delete {
            background: rgba(239, 68, 68, 0.15);
            color: #f87171;
            border: 1px solid rgba(239, 68, 68, 0.3);
        }

            .btn-action.btn-delete:hover {
                background: #ef4444;
                color: #ffffff;
                transform: translateY(-2px);
            }

    .admin-card-footer {
        padding: 16px 28px;
        background: rgba(26, 36, 61, 0.4);
        border-top: 1px solid #23314d;
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: #64748b;
        font-size: 13px;
    }

    .total-badge {
        font-weight: 600;
        color: #cbd5e1;
        background: #1a243d;
        padding: 6px 14px;
        border-radius: 20px;
        border: 1px solid #2a3a5c;
    }
</style>

<div class="admin-wrapper">

    <div class="admin-topbar">
        <a asp-controller="Trangchu" asp-action="Trangdau" class="btn-custom-back">
            <i class="bi bi-arrow-left me-2"></i> Về trang chủ
        </a>
        <a asp-controller="Nhanvien" asp-action="Themnhanvien" class="btn-custom-add">
            <i class="fa-solid fa-user-plus me-2"></i> Thêm nhân viên mới
        </a>
    </div>

    <div class="admin-card">

        <div class="admin-card-header">
            <div class="admin-title">
                <h4><i class="bi bi-person-badge me-2" style="color: #38bdf8;"></i>Quản lý nhân viên</h4>
                <p>Danh sách toàn bộ nhân sự đang làm việc trong hệ thống NewsCMS.</p>
            </div>

            <form asp-controller="Nhanvien" asp-action="Nhanvien" method="get">
                <div class="search-group">
                    <input type="text" name="tk" class="form-control" placeholder="Tìm theo tên hoặc SĐT..." value="@Context.Request.Query["tk"]" />
                    <button type="submit"><i class="bi bi-search"></i></button>
                    @if (!string.IsNullOrEmpty(Context.Request.Query["tk"]))
                    {
                        <a asp-controller="Nhanvien" asp-action="Nhanvien" class="btn-refresh" title="Làm mới">
                            <i class="bi bi-arrow-clockwise"></i>
                        </a>
                    }
                </div>
            </form>
        </div>

        <div class="table-responsive">
            <table class="table table-custom align-middle">
                <thead>
                    <tr>
                        <th class="text-center" style="width: 10%;">Mã NV</th>
                        <th style="width: 28%;">Họ và tên</th>
                        <th style="width: 20%;">Số điện thoại</th>
                        <th class="text-center" style="width: 15%;">Mã tài khoản</th>
                        <th style="width: 15%;">Ngày vào làm</th>
                        <th class="text-center" style="width: 12%;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (bang != null && bang.Any())
                    {
                        foreach (var nv in bang)
                        {
                            <tr>
                                <td class="text-center">
                                    <span class="badge-code">NV-@nv.MaNhanVien</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="staff-avatar">
                                            @nv.HoTen.Substring(0, 1).ToUpper()
                                        </div>
                                        <span class="fw-semibold" style="color: #f8fafc;">@nv.HoTen</span>
                                    </div>
                                </td>
                                <td>
                                    <i class="bi bi-telephone me-2 small" style="color: #64748b;"></i>@nv.SoDienThoai
                                </td>
                                <td class="text-center">
                                    <span class="badge-account">
                                        <i class="bi bi-key me-1" style="color: #fbbf24;"></i> TK-@nv.MaTaiKhoan
                                    </span>
                                </td>
                                <td>
                                    <span class="small" style="color: #94a3b8;">
                                        <i class="bi bi-calendar3 me-1"></i> @nv.NgayVaoLam
                                    </span>
                                </td>
                                <td class="text-center">
                                    <a asp-controller="Nhanvien" asp-action="Suanhanvien" asp-route-ma="@nv.MaNhanVien" class="btn btn-action btn-edit" title="Sửa thông tin">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a asp-controller="Nhanvien" asp-action="Xoanhanvien" asp-route-ma="@nv.MaNhanVien" class="btn btn-action btn-delete" title="Xóa nhân viên">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5" style="color: #64748b;">
                                <div class="py-4">
                                    <i class="bi bi-folder2-open fs-1 mb-3 d-block" style="color: #475569;"></i>
                                    <p class="mb-0 fw-medium">Không tìm thấy nhân viên nào trong hệ thống.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="admin-card-footer">
            <span>Hệ thống quản lý nội dung NewsCMS</span>
            <div class="total-badge">
                Tổng số: <span style="color: #38bdf8;">@(bang?.Count() ?? 0)</span> nhân viên
            </div>
        </div>

    </div>
</div>