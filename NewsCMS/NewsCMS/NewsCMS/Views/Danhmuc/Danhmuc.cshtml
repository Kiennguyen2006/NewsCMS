@using NewsCMS.Models
@{
    Layout = "~/Views/Shared/_AdminLTELayout.cshtml";
}
@model IEnumerable<NewsCMS.Models.BaiVietModel>
@{
    ViewData["Title"] = "Quản lý danh mục";

    var bang = ViewBag.bang as IEnumerable<DanhMucModel>
               ?? Enumerable.Empty<DanhMucModel>();

    string ma = Context.Request.Query["ma"].ToString();
}

<style>
    .dm-wrapper {
        min-height: 85vh;
        padding: 15px;
    }

    .btn-slate-back {
        background: #1a243d;
        border: 1px solid #2a3a5c;
        color: #38bdf8;
        border-radius: 10px;
        padding: 9px 18px;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.2s ease;
        text-decoration: none;
    }

        .btn-slate-back:hover {
            background: rgba(56, 189, 248, 0.15);
            border-color: #38bdf8;
            color: #ffffff;
            transform: translateY(-2px);
        }

    .btn-slate-primary {
        background: linear-gradient(135deg, #0284c7, #2563eb);
        border: 1px solid rgba(56, 189, 248, 0.4);
        color: #ffffff;
        border-radius: 10px;
        padding: 10px 22px;
        font-weight: 600;
        font-size: 14px;
        box-shadow: 0 4px 15px rgba(2, 132, 199, 0.25);
        transition: all 0.2s ease;
        text-decoration: none;
    }

        .btn-slate-primary:hover {
            opacity: 0.92;
            color: #ffffff;
            transform: translateY(-2px);
        }

    .btn-slate-secondary {
        background: #1e293b;
        border: 1px solid #334155;
        color: #cbd5e1;
        border-radius: 10px;
        padding: 10px 18px;
        font-weight: 600;
        transition: all 0.2s ease;
    }

        .btn-slate-secondary:hover {
            background: #334155;
            color: #ffffff;
        }

    .dm-card {
        background: #131b2e;
        border: 1px solid #23314d;
        border-radius: 16px;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.3);
        overflow: hidden;
    }

    .dm-card-header {
        background: rgba(26, 36, 61, 0.6);
        border-bottom: 1px solid #23314d;
        padding: 20px 24px;
    }

    .dm-form-label {
        color: #cbd5e1;
        font-size: 14px;
        margin-bottom: 8px;
    }

    .dm-input {
        background-color: #1a243d !important;
        border: 1px solid #2a3a5c !important;
        color: #f1f5f9 !important;
        border-radius: 10px !important;
        padding: 11px 16px !important;
        font-size: 14px;
        transition: all 0.2s ease;
    }

        .dm-input:focus {
            border-color: #38bdf8 !important;
            box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15) !important;
        }

        .dm-input::placeholder {
            color: #64748b;
        }

    .slate-badge-count {
        background: rgba(56, 189, 248, 0.15);
        color: #38bdf8;
        border: 1px solid rgba(56, 189, 248, 0.3);
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .slate-table {
        color: #e2e8f0;
        margin-bottom: 0;
    }

        .slate-table thead th {
            background: #1a243d;
            color: #94a3b8;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            border-bottom: 1px solid #23314d;
            border-top: none;
            padding: 15px 18px;
        }

        .slate-table tbody td {
            background: transparent;
            border-bottom: 1px solid #1e293b;
            padding: 15px 18px;
            vertical-align: middle;
            color: #cbd5e1;
            font-size: 14px;
        }

        .slate-table tbody tr {
            transition: background-color 0.2s ease;
        }

            .slate-table tbody tr:hover td {
                background-color: rgba(56, 189, 248, 0.06);
            }

            .slate-table tbody tr:last-child td {
                border-bottom: none;
            }

    .status-active {
        background: rgba(16, 185, 129, 0.15);
        color: #34d399;
        border: 1px solid rgba(16, 185, 129, 0.3);
        padding: 6px 13px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .status-inactive {
        background: #1e293b;
        color: #94a3b8;
        border: 1px solid #334155;
        padding: 6px 13px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .btn-edit-pill {
        background: rgba(245, 158, 11, 0.15);
        color: #fbbf24;
        border: 1px solid rgba(245, 158, 11, 0.3);
        border-radius: 20px;
        padding: 6px 15px;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .btn-edit-pill:hover {
            background: #f59e0b;
            color: #0f172a;
            transform: translateY(-2px);
        }

    .dm-card-footer {
        background: rgba(26, 36, 61, 0.4);
        border-top: 1px solid #23314d;
        padding: 15px 24px;
        color: #64748b;
        font-size: 13px;
    }
</style>

<div class="container dm-wrapper py-4">

    <div class="mb-4">
        <a href="/Trangchu/Trangdau" class="btn btn-slate-back">
            <i class="bi bi-arrow-left me-2"></i>
            Quay về trang chủ
        </a>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1" style="color: #f8fafc;">
                <i class="bi bi-folder2-open me-2" style="color: #38bdf8;"></i>
                Quản lý danh mục
            </h2>

            <p class="mb-0" style="color: #94a3b8; font-size: 14px;">
                Quản lý và theo dõi các danh mục tin tức trong hệ thống.
            </p>
        </div>

        <a asp-action="Themdanhmuc" class="btn btn-slate-primary">
            <i class="bi bi-plus-circle me-2"></i>
            Thêm danh mục
        </a>
    </div>

    <div class="dm-card mb-4">
        <div class="p-4">

            <form asp-action="Danhmuc" method="get">
                <div class="row g-3 align-items-end">

                    <div class="col-md-9">
                        <label class="form-label dm-form-label fw-semibold">
                            Tìm kiếm danh mục
                        </label>

                        <input type="text"
                               name="ma"
                               value="@ma"
                               class="form-control dm-input"
                               placeholder="Nhập tên danh mục cần tìm..." />
                    </div>

                    <div class="col-md-3 d-flex gap-2">

                        <button type="submit"
                                class="btn btn-slate-primary flex-grow-1">
                            <i class="bi bi-search me-1"></i>
                            Tìm kiếm
                        </button>

                        <a asp-action="Danhmuc"
                           class="btn btn-slate-secondary d-inline-flex align-items-center"
                           title="Làm mới">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>

                    </div>

                </div>
            </form>

        </div>
    </div>

    <div class="dm-card">

        <div class="dm-card-header">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                <h5 class="fw-bold mb-0" style="color: #f8fafc; font-size: 16px;">
                    <i class="bi bi-list-ul me-2" style="color: #38bdf8;"></i>
                    Danh sách danh mục
                </h5>

                <span class="slate-badge-count">
                    @bang.Count() danh mục
                </span>

            </div>

        </div>

        <div class="table-responsive">

            <table class="table slate-table align-middle mb-0">

                <thead>
                    <tr>
                        <th class="ps-4" style="width: 80px;">STT</th>
                        <th>Mã danh mục</th>
                        <th>Tên danh mục</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>

                <tbody>

                    @if (bang.Any())
                    {
                        var stt = 1;

                        foreach (var item in bang)
                        {
                            <tr>

                                <td class="ps-4 fw-semibold" style="color: #64748b;">
                                    @stt
                                </td>

                                <td>
                                    <span class="fw-bold" style="color: #38bdf8;">
                                        #@item.MaDanhMuc
                                    </span>
                                </td>

                                <td>
                                    <span class="fw-semibold" style="color: #f8fafc;">
                                        @item.TenDanhMuc
                                    </span>
                                </td>

                                <td>
                                    @if (item.TrangThai)
                                    {
                                        <span class="status-active">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Đang hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-inactive">
                                            <i class="bi bi-pause-circle me-1"></i>
                                            Ngừng hoạt động
                                        </span>
                                    }
                                </td>

                                <td class="text-center">

                                    <a asp-action="Suadanhmuc"
                                       asp-route-ma="@item.MaDanhMuc"
                                       class="btn-edit-pill">

                                        <i class="bi bi-pencil-square me-1"></i>
                                        Sửa

                                    </a>

                                </td>

                            </tr>

                            stt++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5" style="color: #64748b;">

                                <i class="bi bi-folder-x display-5" style="color: #475569;"></i>

                                <h6 class="fw-bold mt-3" style="color: #cbd5e1;">
                                    Không tìm thấy danh mục
                                </h6>

                                <p class="mb-0">
                                    Hãy thử tìm kiếm bằng tên danh mục khác.
                                </p>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>
        </div>
        <div class="dm-card-footer">
            Hiển thị <strong style="color: #38bdf8;">@bang.Count()</strong> danh mục.
        </div>

    </div>

</div>