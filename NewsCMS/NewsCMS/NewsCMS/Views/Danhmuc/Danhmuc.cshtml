@using NewsCMS.Models
@{
    Layout = "~/Views/Shared/_AdminLTELayout.cshtml";
}
@model IEnumerable<NewsCMS.Models.BaiVietModel>
@{
    ViewData["Title"] = "Quản lý danh mục";

    var bang = ViewBag.bang as IEnumerable<DanhMucModel>
               ?? Enumerable.Empty<DanhMucModel>();

    string ma = Context.Request.Query["ma"].ToString();
}

<div class="container py-5">

    <!-- Nút quay về trang chủ -->
    <div class="mb-4">
        <a href="/Trangchu/Trangdau"
           class="btn btn-outline-secondary rounded-3 px-3">
            <i class="bi bi-arrow-left me-2"></i>
            Quay về trang chủ
        </a>
    </div>

    <!-- Tiêu đề -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">
                <i class="bi bi-folder2-open me-2"></i>
                Quản lý danh mục
            </h2>

            <p class="text-muted mb-0">
                Quản lý và theo dõi các danh mục tin tức trong hệ thống.
            </p>
        </div>

        <a asp-action="Themdanhmuc"
           class="btn btn-primary rounded-3 px-4 py-2 shadow-sm">
            <i class="bi bi-plus-circle me-2"></i>
            Thêm danh mục
        </a>
    </div>

    <!-- Tìm kiếm -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">

            <form asp-action="Danhmuc" method="get">
                <div class="row g-3 align-items-end">

                    <div class="col-md-9">
                        <label class="form-label fw-semibold">
                            Tìm kiếm danh mục
                        </label>

                        <input type="text"
                               name="ma"
                               value="@ma"
                               class="form-control form-control-lg rounded-3"
                               placeholder="Nhập tên danh mục cần tìm..." />
                    </div>

                    <div class="col-md-3 d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary btn-lg rounded-3 flex-grow-1">
                            <i class="bi bi-search me-1"></i>
                            Tìm kiếm
                        </button>

                        <a asp-action="Danhmuc"
                           class="btn btn-outline-secondary btn-lg rounded-3"
                           title="Làm mới">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>

                    </div>

                </div>
            </form>

        </div>
    </div>

    <!-- Danh sách danh mục -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <div class="card-header bg-white border-0 p-4">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                <h5 class="fw-bold mb-0">
                    <i class="bi bi-list-ul text-primary me-2"></i>
                    Danh sách danh mục
                </h5>

                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">
                    @bang.Count() danh mục
                </span>

            </div>

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th class="ps-4" style="width: 80px;">STT</th>
                        <th>Mã danh mục</th>
                        <th>Tên danh mục</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>

                <tbody>

                    @if (bang.Any())
                    {
                        var stt = 1;

                        foreach (var item in bang)
                        {
                            <tr>

                                <td class="ps-4 fw-semibold text-muted">
                                    @stt
                                </td>

                                <td>
                                    <span class="text-secondary fw-semibold">
                                        @item.MaDanhMuc
                                    </span>
                                </td>

                                <td>
                                    <span class="fw-semibold">
                                        @item.TenDanhMuc
                                    </span>
                                </td>

                                <td>
                                    @if (item.TrangThai)
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Đang hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-2">
                                            <i class="bi bi-pause-circle me-1"></i>
                                            Ngừng hoạt động
                                        </span>
                                    }
                                </td>

                                <td class="text-center">

                                    <a asp-action="Suadanhmuc"
                                       asp-route-ma="@item.MaDanhMuc"
                                       class="btn btn-sm btn-outline-primary rounded-3 px-3">

                                        <i class="bi bi-pencil-square me-1"></i>
                                        Sửa

                                    </a>

                                </td>

                            </tr>

                            stt++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">

                                <i class="bi bi-folder-x display-5 text-secondary"></i>

                                <h6 class="fw-bold mt-3">
                                    Không tìm thấy danh mục
                                </h6>

                                <p class="text-muted mb-0">
                                    Hãy thử tìm kiếm bằng tên danh mục khác.
                                </p>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>
        </div>
        <div class="card-footer bg-white border-0 p-3 text-muted small">
            Hiển thị @bang.Count() danh mục.
        </div>

    </div>

</div>
