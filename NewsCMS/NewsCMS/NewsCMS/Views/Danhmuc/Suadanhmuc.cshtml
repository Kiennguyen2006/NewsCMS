@{
    Layout = "~/Views/Shared/_AdminLTELayout.cshtml";
}
@{
    ViewData["Title"] = "Sửa danh mục";
    var bang = ViewBag.bang;
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Sửa danh mục</h4>
        </div>

        <div class="card-body">
            <form asp-controller="Danhmuc" asp-action="Suadm" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" name="MaDanhMuc" value="@bang.MaDanhMuc" />

                <div class="mb-3">
                    <label class="form-label">Tên danh mục</label>
                    <input type="text" name="TenDanhMuc"
                           class="form-control"
                           value="@bang.TenDanhMuc" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Mô tả</label>
                    <textarea name="MoTa" class="form-control"
                              rows="4">@bang.MoTa</textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Trạng thái</label>
                    <select name="TrangThai" class="form-select">
                        @if (bang.TrangThai == true)
                        {
                            <option value="true" selected>Hoạt động</option>
                            <option value="false">Ngừng hoạt động</option>
                        }
                        else
                        {
                            <option value="true">Hoạt động</option>
                            <option value="false" selected>Ngừng hoạt động</option>
                        }
                    </select>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Lưu thay đổi
                    </button>

                    <a asp-controller="Danhmuc"
                       asp-action="Danhmuc"
                       class="btn btn-secondary">
                        Quay lại
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>