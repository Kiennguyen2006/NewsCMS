@{
    Layout = "~/Views/Shared/_AdminLTELayout.cshtml";
}
@model NewsCMS.Models.DanhMucModel

@{
    ViewData["Title"] = "Thêm danh mục";
}

<style>
    .category-page {
        min-height: 85vh;
        padding: 25px 15px;
    }

    .category-wrapper {
        max-width: 850px;
        margin: auto;
    }

    .category-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #1a243d;
        border: 1px solid #2a3a5c;
        color: #38bdf8;
        padding: 9px 18px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
        transition: 0.25s;
    }

        .category-back:hover {
            background: rgba(56, 189, 248, 0.15);
            border-color: #38bdf8;
            color: #ffffff;
            transform: translateY(-2px);
        }

    .category-heading {
        margin: 24px 0;
    }

        .category-heading h2 {
            color: #f8fafc;
            font-weight: 800;
            font-size: 24px;
            letter-spacing: -0.5px;
        }

            .category-heading h2 i {
                color: #38bdf8;
            }

        .category-heading p {
            color: #94a3b8;
            font-size: 14px;
            margin-top: 6px;
        }

    .category-card {
        background: #131b2e;
        border: 1px solid #23314d;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.35);
    }

    .category-card-header {
        padding: 22px 28px;
        background: linear-gradient(135deg, rgba(2, 132, 199, 0.25), rgba(37, 99, 235, 0.25));
        border-bottom: 1px solid rgba(56, 189, 248, 0.3);
    }

        .category-card-header h5 {
            color: #f8fafc;
            font-weight: 700;
            font-size: 18px;
            margin-bottom: 4px;
        }

            .category-card-header h5 i {
                color: #38bdf8;
            }

        .category-card-header p {
            margin: 0;
            color: #94a3b8;
            font-size: 13px;
        }

    .category-card-body {
        padding: 30px;
    }

    .form-label {
        color: #cbd5e1;
        font-weight: 600;
        font-size: 14px;
        margin-bottom: 8px;
    }

    .form-control,
    .form-select {
        background-color: #1a243d !important;
        border: 1px solid #2a3a5c !important;
        border-radius: 10px !important;
        padding: 11px 14px !important;
        color: #f1f5f9 !important;
        font-size: 14px;
        transition: all .25s ease;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #38bdf8 !important;
            box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15) !important;
            background-color: #1e2a47 !important;
        }

        .form-control::placeholder {
            color: #64748b;
        }

    textarea.form-control {
        resize: vertical;
        min-height: 120px;
    }

    .field-hint {
        color: #64748b;
        font-size: 12px;
        margin-top: 6px;
    }

    .required-mark {
        color: #f87171;
    }

    .category-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        border-top: 1px solid #23314d;
        padding-top: 22px;
        margin-top: 26px;
    }

    .btn-category {
        border-radius: 10px;
        padding: 10px 22px;
        font-weight: 600;
        font-size: 14px;
        transition: all .25s ease;
    }

        .btn-category:hover {
            transform: translateY(-2px);
        }

    .btn-save {
        color: white;
        background: linear-gradient(135deg, #0284c7, #2563eb);
        border: 1px solid rgba(56, 189, 248, 0.4);
        box-shadow: 0 4px 15px rgba(2, 132, 199, 0.25);
    }

        .btn-save:hover {
            color: white;
            opacity: 0.92;
        }

    .btn-cancel {
        color: #cbd5e1;
        background: #1e293b;
        border: 1px solid #334155;
        text-decoration: none;
    }

        .btn-cancel:hover {
            color: #ffffff;
            background: #334155;
        }

    .validation-summary-errors,
    .field-validation-error {
        color: #f87171;
        font-size: 13px;
    }

    @@media (max-width: 576px) {
        .category-page {
            padding: 15px 10px;
        }

        .category-card-body {
            padding: 20px 18px;
        }

        .category-card-header {
            padding: 20px;
        }

        .category-actions {
            flex-direction: column-reverse;
        }

            .category-actions .btn {
                width: 100%;
            }
    }
</style>

<div class="category-page">
    <div class="category-wrapper">

        <a asp-action="Danhmuc" class="category-back">
            <i class="bi bi-arrow-left"></i>
            Quay lại danh sách danh mục
        </a>

        <div class="category-heading">
            <h2>
                <i class="bi bi-folder-plus me-2"></i>
                Thêm danh mục mới
            </h2>
            <p>
                Tạo danh mục để phân loại và quản lý các bài viết trên hệ thống.
            </p>
        </div>

        <div class="category-card">

            <div class="category-card-header">
                <h5>
                    <i class="bi bi-pencil-square me-2"></i>
                    Thông tin danh mục
                </h5>
                <p>Vui lòng nhập thông tin danh mục bên dưới.</p>
            </div>

            <div class="category-card-body">

                <form asp-controller="Danhmuc"
                      asp-action="Themdm"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="TenDanhMuc" class="form-label">
                            Tên danh mục
                            <span class="required-mark">*</span>
                        </label>

                        <input asp-for="TenDanhMuc"
                               class="form-control"
                               placeholder="Ví dụ: Công nghệ, Thể thao, Giáo dục..."
                               maxlength="100" />

                        <span asp-validation-for="TenDanhMuc"
                              class="field-validation-error"></span>

                        <div class="field-hint">
                            Tên danh mục không được vượt quá 100 ký tự.
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="MoTa" class="form-label">
                            Mô tả danh mục
                        </label>

                        <textarea asp-for="MoTa"
                                  class="form-control"
                                  rows="4"
                                  maxlength="500"
                                  placeholder="Nhập nội dung mô tả cho danh mục..."></textarea>

                        <span asp-validation-for="MoTa"
                              class="field-validation-error"></span>

                        <div class="field-hint">
                            Mô tả tối đa 500 ký tự.
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="TrangThai" class="form-label">
                            Trạng thái danh mục
                        </label>

                        <select asp-for="TrangThai"
                                class="form-select">
                            <option value="true">Đang hoạt động</option>
                            <option value="false">Ngừng hoạt động</option>
                        </select>

                        <span asp-validation-for="TrangThai"
                              class="field-validation-error"></span>

                        <div class="field-hint">
                            Bạn có thể thay đổi trạng thái danh mục sau này.
                        </div>
                    </div>

                    <div class="category-actions">

                        <a asp-action="Danhmuc"
                           class="btn btn-category btn-cancel">
                            <i class="bi bi-x-circle me-1"></i>
                            Hủy
                        </a>

                        <button type="submit"
                                class="btn btn-category btn-save">
                            <i class="bi bi-check-circle me-1"></i>
                            Lưu danh mục
                        </button>

                    </div>

                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}