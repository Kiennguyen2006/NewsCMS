@using NewsCMS.Models

@{
    Layout = "~/Views/Shared/_AdminLTELayout.cshtml";
    ViewData["Title"] = "Xác nhận xóa bình luận";
    var dongxoa = ViewBag.dongxoa as BinhluanModel;
}

<style>
    .delete-comment-page {
        max-width: 820px;
        margin: 25px auto;
        padding: 0 15px;
    }

    .delete-card {
        background: #131b2e;
        border: 1px solid #23314d;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.35);
    }

    .delete-header {
        background: linear-gradient(135deg, rgba(220, 38, 38, 0.25), rgba(153, 27, 27, 0.35));
        border-bottom: 1px solid rgba(239, 68, 68, 0.3);
        text-align: center;
        padding: 30px 25px;
    }

    .delete-icon {
        width: 64px;
        height: 64px;
        background: rgba(239, 68, 68, 0.15);
        border: 1px solid rgba(239, 68, 68, 0.35);
        color: #f87171;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 14px;
        font-size: 26px;
    }

    .delete-header h3 {
        color: #f87171;
        font-weight: 800;
        font-size: 22px;
        margin-bottom: 6px;
    }

    .delete-header p {
        margin: 0;
        color: #94a3b8;
        font-size: 14px;
    }

    .delete-body {
        padding: 30px;
    }

    .delete-warning {
        background: rgba(245, 158, 11, 0.12);
        border: 1px solid rgba(245, 158, 11, 0.3);
        border-radius: 12px;
        padding: 15px 18px;
        color: #fbbf24;
        font-size: 14px;
        line-height: 1.6;
        margin-bottom: 24px;
    }

    .comment-info-table {
        border: 1px solid #23314d;
        border-radius: 12px;
        overflow: hidden;
    }

        .comment-info-table table {
            margin-bottom: 0;
            width: 100%;
            border-collapse: collapse;
        }

        .comment-info-table tr {
            border-bottom: 1px solid #23314d;
        }

            .comment-info-table tr:last-child {
                border-bottom: none;
            }

        .comment-info-table th {
            width: 32%;
            background: #1a243d;
            color: #94a3b8;
            font-weight: 600;
            font-size: 14px;
            padding: 14px 16px;
        }

        .comment-info-table td {
            background: #131b2e;
            padding: 14px 16px;
            color: #f1f5f9;
            font-size: 14px;
        }

    .comment-content-box {
        background: #1a243d;
        border: 1px solid #2a3a5c;
        border-radius: 10px;
        padding: 12px 15px;
        color: #e2e8f0;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        line-height: 1.6;
    }

    .delete-footer {
        border-top: 1px solid #23314d;
        margin-top: 25px;
        padding-top: 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

    .btn-slate-cancel {
        background: #1e293b;
        border: 1px solid #334155;
        color: #cbd5e1;
        border-radius: 10px;
        padding: 10px 22px;
        font-weight: 600;
        font-size: 14px;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .btn-slate-cancel:hover {
            background: #334155;
            color: #ffffff;
        }

    .btn-confirm-delete {
        background: linear-gradient(135deg, #dc2626, #b91c1c);
        border: 1px solid rgba(248, 113, 113, 0.4);
        color: white;
        border-radius: 10px;
        padding: 10px 24px;
        font-weight: 600;
        font-size: 14px;
        box-shadow: 0 4px 15px rgba(220, 38, 38, 0.3);
        transition: all 0.2s ease;
    }

        .btn-confirm-delete:hover {
            background: linear-gradient(135deg, #ef4444, #dc2626);
            color: white;
            transform: translateY(-1px);
        }
</style>

<div class="delete-comment-page">
    @if (dongxoa != null)
    {
        <div class="delete-card">
            <div class="delete-header">
                <div class="delete-icon">
                    <i class="bi bi-trash3-fill"></i>
                </div>
                <h3>Xác nhận xóa bình luận</h3>
                <p>Kiểm tra nội dung bình luận trước khi xóa khỏi hệ thống.</p>
            </div>

            <div class="delete-body">
                <div class="delete-warning">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    Bạn có chắc chắn muốn xóa bình luận này không?
                    <strong>Thao tác này không thể hoàn tác.</strong>
                </div>

                <div class="comment-info-table">
                    <table class="table table-borderless">
                        <tr>
                            <th>Mã bình luận</th>
                            <td><strong style="color: #38bdf8;">#@dongxoa.MaBinhLuan</strong></td>
                        </tr>
                        <tr>
                            <th>Mã bài viết</th>
                            <td><span style="color: #cbd5e1;">#@dongxoa.MaBaiViet</span></td>
                        </tr>
                        <tr>
                            <th>Mã độc giả</th>
                            <td><span style="color: #cbd5e1;">#@dongxoa.MaDocGia</span></td>
                        </tr>
                        <tr>
                            <th>Nội dung</th>
                            <td>
                                <div class="comment-content-box">@dongxoa.NoiDung</div>
                            </td>
                        </tr>
                        <tr>
                            <th>Ngày bình luận</th>
                            <td style="color: #94a3b8;">
                                <i class="bi bi-clock me-1"></i>
                                @dongxoa.NgayBinhLuan.ToString("dd/MM/yyyy HH:mm:ss")
                            </td>
                        </tr>
                    </table>
                </div>

                <div class="delete-footer">
                    <a asp-controller="Binhluan"
                       asp-action="Binhluan"
                       class="btn-slate-cancel">
                        <i class="bi bi-arrow-left me-1"></i>
                        Quay lại
                    </a>

                    <form asp-controller="Binhluan"
                          asp-action="Xoa"
                          asp-route-ma="@dongxoa.MaBinhLuan"
                          method="post"
                          class="m-0">
                        @Html.AntiForgeryToken()

                        <button type="submit" class="btn btn-confirm-delete">
                            <i class="bi bi-trash3 me-1"></i>
                            Xác nhận xóa
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert rounded-3 p-4 mb-3" style="background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171;">
            <i class="bi bi-exclamation-circle me-2"></i>
            Không tìm thấy bình luận cần xóa.
        </div>

        <a asp-controller="Binhluan"
           asp-action="Binhluan"
           class="btn-slate-cancel d-inline-block">
            <i class="bi bi-arrow-left me-1"></i>
            Quay lại
        </a>
    }
</div>